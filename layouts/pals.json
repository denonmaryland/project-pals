{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    14,
    18
  ],
  "preview": "layouts/pals.svg",
  "background": "chrome",
  "ui_font": "Adwaita Sans",
  "terminal_padding": [
    16,
    14
  ],
  "resizable": false,
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "body",
      "type": "row",
      "divider": {
        "width": 0,
        "color": "chrome"
      },
      "children": [
        {
          "id": "pal-rail",
          "type": "block",
          "hidden": true,
          "size": {
            "px": 60
          },
          "min": 60,
          "max": 60,
          "content": {
            "mod": "crew-palrail"
          }
        },
        {
          "id": "sidebar",
          "type": "block",
          "size": {
            "px": 304
          },
          "min": 56,
          "max": 440,
          "content": {
            "mod": "crew-roster"
          }
        },
        {
          "id": "frame",
          "type": "column",
          "padding": [
            8,
            10
          ],
          "resizable": false,
          "children": [
            {
              "id": "crew-tabs",
              "type": "block",
              "size": {
                "px": 38
              },
              "content": {
                "mod": "crew-tabs"
              },
              "window_drag": true,
              "hidden": true
            },
            {
              "id": "sheet",
              "type": "row",
              "radius": 8,
              "background": "surface",
              "border": {
                "width": 1,
                "color": "border"
              },
              "divider": {
                "width": 1,
                "color": "border"
              },
              "children": [
                {
                  "id": "work",
                  "type": "column",
                  "resizable": false,
                  "children": [
                    {
                      "id": "crew-header",
                      "type": "block",
                      "size": {
                        "px": 52
                      },
                      "content": {
                        "mod": "crew-header"
                      },
                      "window_drag": true
                    },
                    {
                      "id": "center",
                      "type": "stack",
                      "active": "tab-view",
                      "children": [
                        {
                          "id": "tab-view",
                          "type": "block",
                          "padding": [
                            0,
                            24
                          ],
                          "content": {
                            "tab": "active",
                            "pane": {
                              "gap": 8,
                              "radius": 6,
                              "background": "background",
                              "border": {
                                "width": 1,
                                "color": "border"
                              },
                              "focus": {
                                "width": 1,
                                "color": "accent"
                              },
                              "lone": true
                            }
                          }
                        },
                        {
                          "id": "room-view",
                          "type": "block",
                          "content": {
                            "mod": "crew-room"
                          }
                        },
                        {
                          "id": "chat-view",
                          "type": "block",
                          "content": {
                            "mod": "crew-chat"
                          }
                        }
                      ]
                    },
                    {
                      "id": "crew-composer",
                      "type": "block",
                      "size": {
                        "px": 104
                      },
                      "content": {
                        "mod": "crew-composer"
                      }
                    }
                  ]
                },
                {
                  "id": "panel",
                  "type": "block",
                  "hidden": true,
                  "size": {
                    "px": 320
                  },
                  "min": 260,
                  "max": 520,
                  "content": {
                    "mod": "crew-side"
                  }
                },
                {
                  "id": "rail",
                  "type": "block",
                  "size": {
                    "px": 48
                  },
                  "min": 48,
                  "max": 48,
                  "content": {
                    "mod": "crew-rail"
                  }
                }
              ]
            }
          ],
          "gap": 6
        }
      ]
    },
    {
      "id": "status",
      "type": "block",
      "size": {
        "px": 28
      },
      "min": 28,
      "max": 28,
      "content": {
        "mod": "crew-status"
      }
    }
  ]
}
