{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    14,
    18
  ],
  "preview": "layouts/pals.svg",
  "terminal_menu": "crew-termmenu",
  "background": "#0B0B0C",
  "ui_font": "Inter",
  "colors": {
    "background": "#0B0B0C"
  },
  "terminal_padding": [
    8,
    8
  ],
  "resizable": false,
  "divider": {
    "width": 0,
    "color": "#1E1E20"
  },
  "children": [
    {
      "id": "body",
      "type": "row",
      "divider": {
        "width": 0,
        "color": "#1E1E20"
      },
      "children": [
        {
          "id": "sidebar",
          "type": "block",
          "size": {
            "px": 304
          },
          "min": 56,
          "max": 440,
          "content": {
            "mod": "crew-roster"
          }
        },
        {
          "id": "work",
          "type": "column",
          "resizable": false,
          "background": "#0B0B0C",
          "children": [
            {
              "id": "crew-header",
              "type": "block",
              "size": {
                "px": 52
              },
              "content": {
                "mod": "crew-header"
              },
              "window_drag": true
            },
            {
              "id": "center",
              "type": "stack",
              "active": "tab-view",
              "children": [
                {
                  "id": "tab-view",
                  "type": "block",
                  "padding": [
                    8,
                    16
                  ],
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 8,
                      "radius": 4,
                      "border": {
                        "width": 1,
                        "color": "#1E1E20"
                      },
                      "focus": {
                        "width": 1,
                        "color": "#3C3C3F"
                      },
                      "lone": false
                    }
                  }
                },
                {
                  "id": "room-view",
                  "type": "block",
                  "content": {
                    "mod": "crew-room"
                  }
                },
                {
                  "id": "desk-view",
                  "type": "block",
                  "content": {
                    "mod": "crew-desk"
                  }
                },
                {
                  "id": "home-view",
                  "type": "block",
                  "content": {
                    "mod": "crew-home"
                  }
                },
            { "id": "pc-view", "type": "block", "content": { "mod": "crew-computer" } }
              ]
            },
            {
              "id": "crew-composer",
              "type": "block",
              "size": {
                "px": 96
              },
              "content": {
                "mod": "crew-composer"
              },
              "hidden": true
            }
          ]
        },
        {
          "id": "profile",
          "type": "column",
          "size": {
            "px": 420
          },
          "min": 360,
          "hidden": true,
          "background": "#0E0E0F",
          "children": [
            {
              "id": "profile-main",
              "type": "block",
              "content": {
                "mod": "crew-profile",
                "props": {
                  "part": "main"
                }
              }
            },
            {
              "id": "profile-dash",
              "type": "column",
              "hidden": true,
              "resizable": false,
              "children": [
                {
                  "id": "dash-head",
                  "type": "block",
                  "content": {
                    "mod": "crew-profile",
                    "props": {
                      "part": "head"
                    }
                  },
                  "size": {
                    "px": 52
                  }
                },
                {
                  "id": "dash-body",
                  "type": "row",
                  "children": [
                    {
                      "id": "dash-stage",
                      "type": "block",
                      "content": {
                        "mod": "crew-profile",
                        "props": {
                          "part": "stage"
                        }
                      }
                    },
                    {
                      "id": "dash-right",
                      "type": "column",
                      "size": {
                        "px": 460
                      },
                      "min": 320,
                      "background": "#0B0B0C",
                      "children": [
                        {
                          "id": "dash-tbar",
                          "type": "block",
                          "content": {
                            "mod": "crew-profile",
                            "props": {
                              "part": "tbar"
                            }
                          },
                          "size": {
                            "px": 33
                          }
                        },
                        {
                          "id": "dash-term",
                          "type": "block",
                          "min": 140,
                          "padding": [
                            6,
                            12
                          ],
                          "background": "#0B0B0C",
                          "content": {
                            "agent": "focused"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "status",
      "type": "block",
      "size": {
        "px": 24
      },
      "min": 24,
      "max": 24,
      "content": {
        "mod": "crew-status"
      }
    }
  ]
}
