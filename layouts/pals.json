{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    14,
    18
  ],
  "preview": "layouts/pals.svg",
  "terminal_menu": "crew-termmenu",
  "background": "#0B0B0C",
  "ui_font": "Inter",
  "terminal_padding": [
    16,
    14
  ],
  "resizable": false,
  "divider": {
    "width": 0,
    "color": "#1E1E20"
  },
  "children": [
    {
      "id": "body",
      "type": "row",
      "divider": {
        "width": 0,
        "color": "#1E1E20"
      },
      "children": [
        {
          "id": "pal-rail",
          "type": "block",
          "hidden": true,
          "size": {
            "px": 60
          },
          "min": 60,
          "max": 60,
          "content": {
            "mod": "crew-palrail"
          }
        },
        {
          "id": "sidebar",
          "type": "block",
          "size": {
            "px": 304
          },
          "min": 56,
          "max": 440,
          "content": {
            "mod": "crew-roster"
          }
        },
        {
          "id": "work",
          "type": "column",
          "resizable": false,
          "background": "#0B0B0C",
          "children": [
            {
              "id": "crew-tabs",
              "type": "block",
              "hidden": true,
              "size": {
                "px": 40
              },
              "content": {
                "mod": "crew-tabs"
              },
              "window_drag": true
            },
            {
              "id": "crew-header",
              "type": "block",
              "size": {
                "px": 52
              },
              "content": {
                "mod": "crew-header"
              },
              "window_drag": true
            },
            {
              "id": "center",
              "type": "stack",
              "active": "tab-view",
              "children": [
                {
                  "id": "tab-view",
                  "type": "block",
                  "padding": [
                    12,
                    24
                  ],
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 8,
                      "radius": 4,
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "#1E1E20"
                      },
                      "focus": {
                        "width": 1,
                        "color": "#3C3C3F"
                      },
                      "lone": true
                    }
                  }
                },
                {
                  "id": "room-view",
                  "type": "block",
                  "content": {
                    "mod": "crew-room"
                  }
                }
              ],
              "floating": [
                {
                  "id": "prompt-card",
                  "content": {
                    "mod": "crew-prompt"
                  },
                  "edge": "bottom",
                  "align": "center"
                }
              ]
            },
            {
              "id": "crew-composer",
              "type": "block",
              "size": {
                "px": 96
              },
              "content": {
                "mod": "crew-composer"
              },
              "hidden": true
            }
          ]
        },
        {
          "id": "panel",
          "type": "block",
          "hidden": true,
          "size": {
            "px": 320
          },
          "min": 260,
          "max": 520,
          "content": {
            "mod": "crew-side"
          }
        }
      ]
    },
    {
      "id": "status",
      "type": "block",
      "size": {
        "px": 24
      },
      "min": 24,
      "max": 26,
      "content": {
        "mod": "crew-status"
      }
    }
  ]
}
