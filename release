#!/usr/bin/env bash
# Publish a Project Pals release: everyone's About → Check for updates (and crewd's daily check)
# will see it and can update in one click.
#
#   ./release 0.2.0 "What changed, a few lines"
#   ./release 0.2.0 -F notes.md
#   ./release 0.2.0 --dry-run        every check, and nothing else: no commit, tag, push or release
#
# It sets VERSION, commits, tags v0.2.0, builds dist/project-pals-0.2.0.tar.gz plus SHA256SUMS
# (the updater refuses a download that doesn't match), pushes, and creates the GitHub release.
# Needs: a clean tree on main, the GitHub repo in pals.json created, gh signed in, and the owner's
# go (below). --dry-run needs none of the last.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

# What was asked for, word for word: the owner approves exactly this line (owner_go).
asked="./release $*"
dry=""; rest=()
for a in "$@"; do if [[ "$a" == "--dry-run" ]]; then dry=1; else rest+=("$a"); fi; done
set -- "${rest[@]}"

version="${1:-}"; shift || true
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "usage: ./release X.Y.Z \"notes\" | -F notes.md | --dry-run" >&2; exit 2; }
if [[ "${1:-}" == "-F" ]]; then notes="$(cat "$2")"; else notes="${1:-}"; fi
[[ -n "$notes" || -n "$dry" ]] || { echo "say what changed: ./release $version \"notes\"" >&2; exit 2; }

# The owner's go (T110). On 2026-11-10 this script ran from a plain shell and nothing asked the
# owner: Project Pals' approval gate only watches its pals' terminals. So the script asks itself,
# wherever it runs: the request waits in Project Pals' Inbox, and after the owner's click there the
# same command goes through once (within 30 minutes). A pal whose run the gate already held and the
# owner approved isn't asked twice. Without Project Pals on this computer, the person at the
# keyboard types the version. This stops a release nobody decided on; it isn't a wall against a
# program that runs git push and gh release by hand (protect the branch and tags on GitHub for that).
owner_go() {
  if command -v pal >/dev/null 2>&1 && pal owner-step --probe >/dev/null 2>&1; then
    pal owner-step release-script -- "$asked"
    return $?
  fi
  if ! { : >/dev/tty; } 2>/dev/null; then
    echo "releasing $version needs the owner's go: run it from Project Pals (it asks in the Inbox), or yourself in a terminal" >&2
    return 3
  fi
  printf 'Releasing %s pushes to GitHub and publishes it to every install.\nType %s to go ahead: ' "$version" "$version" >/dev/tty
  local typed=""
  read -r typed </dev/tty || true
  [[ "$typed" == "$version" ]] || { echo "not released" >&2; return 3; }
}

repo="$(python3 -c 'import json; print(json.load(open("pals.json"))["repo"])')"
current="$(cat VERSION)"
# Newer than VERSION, or VERSION already says it (set ahead of the release, so a local install
# reports what it'll ship as) and it isn't tagged yet.
python3 - "$current" "$version" "$(git tag -l "v$version")" <<'PY' || { echo "$version isn't newer than $current (or v$version is already tagged)" >&2; exit 2; }
import sys
t = lambda v: tuple(int(x) for x in v.split("."))
sys.exit(0 if t(sys.argv[2]) > t(sys.argv[1]) or (sys.argv[2] == sys.argv[1] and not sys.argv[3]) else 1)
PY
[[ "$(git branch --show-current)" == "main" ]] || { echo "release from main" >&2; exit 2; }
[[ -z "$(git status --porcelain)" ]] || { echo "commit or stash your changes first" >&2; exit 2; }
gh repo view "$repo" >/dev/null 2>&1 || { echo "GitHub repo $repo doesn't exist yet. Create it first, e.g.: gh repo create $repo --public --source . --push" >&2; exit 2; }

for f in install.sh VERSION pals.json layouts/pals.json; do [[ -e "$f" ]] || { echo "missing $f" >&2; exit 2; }; done

# Before anything is checked at length or changed: the owner's go. A dry run changes nothing, so it's free.
if [[ -z "$dry" ]]; then owner_go || exit 3; fi

# Preflight: nothing broken goes out.
git fetch -q origin main 2>/dev/null || true
if git rev-parse -q --verify origin/main >/dev/null && [[ "$(git rev-parse origin/main)" != "$(git merge-base HEAD origin/main)" ]]; then
  echo "origin/main has commits you don't; pull first" >&2; exit 2
fi
bash -n install.sh release && sh -n bin/crew-hook-fast || exit 2
for f in bin/crew bin/crew-room bin/crewd bin/crew-hook bin/crew-mcp bin/*.py install-hooks.py; do python3 -m py_compile "$f" || { echo "python error in $f" >&2; exit 2; }; done
python3 -m unittest discover -s tests -q || { echo "tests failed" >&2; exit 2; }
for f in layouts/*.json mods/*/mod.json pals.json; do python3 -m json.tool "$f" >/dev/null || { echo "bad JSON in $f" >&2; exit 2; }; done
if command -v node >/dev/null; then
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  for f in lib/*.js mods/*/main.js; do cp "$f" "$tmp/x.mjs"; node --check "$tmp/x.mjs" || { echo "JS syntax error in $f" >&2; exit 2; }; done
fi
# The regression tests (tests/, Python and node): throwaway CREW_DATA and homes, nothing real is
# touched, run in an empty TMPDIR that must be empty again afterwards (T143).
tests/check_tmp.sh || exit 2
# The Desk's Claude Code mod: validated and tested by Claude Code itself, where it's installed.
if command -v claude >/dev/null; then
  claude plugin validate claude-mod/pals >/dev/null || { echo "claude-mod/pals doesn't validate" >&2; exit 2; }
  claude plugin test claude-mod/pals >/dev/null || { echo "claude-mod/pals tests failed" >&2; exit 2; }
fi
find . -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true

if [[ -n "$dry" ]]; then
  echo "dry run: every check passed for $version. Nothing was committed, tagged, pushed or published."
  exit 0
fi

printf '%s\n' "$version" > VERSION
git add VERSION
git commit -q --allow-empty -m "Release v$version"   # empty when VERSION already said it; undo() relies on a commit
git tag -a "v$version" -m "Project Pals $version"
# If publishing fails from here, take the local commit and tag back so a rerun works.
undo() { echo "release failed; undoing the local commit and tag" >&2; git tag -d "v$version" >/dev/null 2>&1; git reset -q --hard HEAD~1; }
trap 'undo' ERR

mkdir -p dist
tarball="dist/project-pals-$version.tar.gz"
git archive --format=tar.gz --prefix="project-pals-$version/" -o "$tarball" "v$version"
(cd dist && sha256sum "project-pals-$version.tar.gz" > SHA256SUMS)

git push -q origin main "v$version"
trap - ERR   # pushed: from here a failure leaves the tag on GitHub; rerun just the gh release command
gh release create "v$version" "$tarball" dist/SHA256SUMS --repo "$repo" --title "Project Pals $version" --notes "$notes"
echo "released $version: installs see it at their next check (About → Check for updates)"
