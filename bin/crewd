#!/usr/bin/env python3
"""crewd: Project Pals's background helper (a systemd user service, herdr-crew.service).

Every couple of seconds it looks at every terminal herdr-core runs and:
- delivers queued messages (pal tell, rooms, tasks) when a pal's turn has ended, never mid-turn;
- notices turns ending and pals getting blocked: tells whoever delegated the work, logs it to the feed;
- notices channels that look stuck (working, screen unchanged) and tells the head pal;
- runs routines on their schedule, skipping a run while the last one is still going;
- after a channel has worked a while, reviews it in the background (a cheap headless model) to
  save durable facts to the pal's daily notes, things about the owner to USER.md, and skills it learned;
- nightly, distills each pal's notes into its MEMORY.md and archives learned skills nobody touched.
"""
import json
import os
import re
import subprocess
import sys
import threading
import time
import traceback
from pathlib import Path

sys.path.insert(0, str(Path.home() / ".local" / "lib" / "herdr-crew"))
from crewlib import (DATA, QUEUE, MEMORY, SKILLS, CrewError, OWNER, load_json, save_json, locked, append_jsonl,
                     hc_terminals, is_agent, screen, meaningful, split_where, send_now, feed, enqueue, without_input_box,
                     herdr_spaces, find, record_of, records, lead, chan, memory_dir, remember, today, now_ms, slug,
                     trust_prompt, trust_notice, input_draft, DraftInTheWay)
import crewskills
import crewroutines
import crewupdate
import crewguard

TICK = 2.0
STALL_MIN = 15          # working with an unchanged screen this long: looks stuck
REVIEW_EVERY = 6        # review a channel's memory after this many finished turns
REVIEW_GAP = 30 * 60    # and at most this often per channel
DISTILL_AT = "03:30"
REVIEW_MODEL = os.environ.get("CREW_REVIEW_MODEL", "haiku")
DISTILL_MODEL = os.environ.get("CREW_DISTILL_MODEL", "sonnet")
LOG = DATA / "crewd.log"


def log(msg):
    line = f"{time.strftime('%H:%M:%S')} {msg}"
    print(line, flush=True)


class Crewd:
    def __init__(self):
        self.prev = {}            # terminal → status last tick
        self.last_sent = {}       # terminal → when we last typed into it
        self.shots = {}           # terminal → (screen hash, since)
        health = load_json(DATA / "crew-health.json", {})
        self.stalled = health.get("stalled", {})
        self.trust = health.get("trust", {})   # terminal → {bot, channel, since}: on the folder-trust question
        self.last_trust_check = 0
        self.drafts = health.get("drafts", {})   # terminal → {bot, channel, since}: holding its messages
        self.first_seen = {}   # terminal → when crewd first saw it (the trust question only comes first)
        self.reviews = load_json(DATA / "crew-reviews.json", {})   # terminal → {turn, at}
        self.busy = threading.Lock()   # one headless model run at a time
        self.last_minute = None
        self.last_stall_check = 0

    # ── main loop ──
    def run(self):
        log("crewd started")
        while True:
            try:
                self.tick()
            except Exception:
                log("tick failed:\n" + traceback.format_exc())
            time.sleep(TICK)

    def tick(self):
        save_json(DATA / "crew-daemon.json", {"at": time.time(), "pid": os.getpid()})
        terms = hc_terminals()
        if not terms:
            return
        self.transitions(terms)
        self.deliver(terms)
        if time.time() - self.last_trust_check > 10:
            self.last_trust_check = time.time()
            self.trust_prompts(terms)
        if time.time() - self.last_stall_check > 60:
            self.last_stall_check = time.time()
            self.stalls(terms)
            try:
                crewguard.tidy()   # unused approvals lapse after 30 minutes; week-old decided ones go
            except Exception:
                log("approval tidy failed:\n" + traceback.format_exc())
        minute = time.strftime("%Y-%m-%d %H:%M")
        if minute != self.last_minute:
            self.last_minute = minute
            crewroutines.tick(terms, log)
            if time.strftime("%H:%M") == DISTILL_AT:
                threading.Thread(target=self.nightly, daemon=True).start()
        crewroutines.watch(terms, log)
        # Updates: look for a newer release once a day (the About dialog and a sidebar dot show it).
        last = load_json(crewupdate.STATE, {}).get("checked", 0)
        if time.time() - last > 24 * 3600 and time.time() - getattr(self, "last_update_try", 0) > 3600:
            self.last_update_try = time.time()
            threading.Thread(target=self.check_updates, daemon=True).start()

    def check_updates(self):
        try:
            info = crewupdate.check()
            if info.get("available"):
                log(f"update available: {info['latest']} (installed {info.get('current')})")
        except Exception as e:
            log(f"update check failed: {e}")

    # ── turns ending ──
    def transitions(self, terms):
        for addr, t in terms.items():
            if not is_agent(t):
                self.prev.pop(addr, None)
                continue
            first = addr not in self.prev
            now, before = t.get("status"), self.prev.get(addr)
            self.prev[addr] = now
            if first:
                continue
            bot, ch = split_where(t.get("where"))
            if before == "working" and now != "working" and now != "blocked":
                feed("finished", terminal=addr, bot=bot, channel=ch, turn=t.get("turn"))
                self.callbacks(addr, t, "finished")
                self.maybe_review(addr, t)
            elif now == "blocked" and before != "blocked":
                feed("blocked", terminal=addr, bot=bot, channel=ch)
                self.callbacks(addr, t, "blocked")
            if now != "working" and addr in self.stalled:
                st = self.stalled.pop(addr, None)
                self.save_health()
                self.notebook_nudge(addr, st, bot, ch)

    def callbacks(self, addr, t, what):
        """Whoever handed this pal work (pal tell) hears how it went."""
        path = DATA / "crew-delegations.json"
        with locked("delegations"):
            dels = load_json(path, [])
            keep, fire = [], []
            for d in dels:
                if d.get("to") == addr and d.get("delivered_at") and now_ms() - d["delivered_at"] > 2500:
                    fire.append(d)
                elif now_ms() - d.get("at", 0) < 24 * 3600 * 1000:
                    keep.append(d)
            if what == "blocked":
                keep += fire  # still open: it'll finish later
            save_json(path, keep)
        bot, ch = split_where(t.get("where"))
        for d in fire:
            ask = " ".join((d.get("text") or "").split())[:90]
            if what == "blocked":
                msg = (f"[pal] {bot} #{ch} is stuck on a question for {OWNER} while on what you asked (\"{ask}\"). "
                       f"It can't go on until {OWNER} answers in its channel; don't answer for {OWNER}.")
            else:
                lines = screen(addr)
                tail = meaningful(without_input_box(lines))[-10:]
                draft = input_draft(lines)
                msg = (f"[pal] {bot} #{ch} finished what you asked (\"{ask}\"). The end of its screen:\n"
                       + "\n".join(tail)
                       + ("\n(Its input box has unsent text: someone is typing there. It hasn't been sent, so it isn't anyone's answer.)" if draft else "")
                       + f"\n(More: pal peek \"{bot}#{ch}\")")
            try:
                enqueue(d["from"], msg, sender="crew", kind="callback")
            except CrewError:
                pass

    # ── delivery between turns ──
    def deliver(self, terms):
        # A hold ends when the terminal's gone or its box is empty again (sent or cleared), even
        # while the pal is busy, so "Waiting on" doesn't show a draft that isn't there any more.
        gone = [a for a in self.drafts if (terms.get(a) or {}).get("state") != "live" or not input_draft(screen(a))]
        for a in gone:
            self.drafts.pop(a)
        if gone:
            self.save_health()
        if not QUEUE.exists():
            return
        for d in QUEUE.iterdir():
            if not d.is_dir():
                continue
            addr = d.name
            items = []
            for f in sorted(d.glob("*.json")):
                try:
                    items.append((f, json.loads(f.read_text())))
                except (OSError, ValueError):
                    f.unlink(missing_ok=True)
            if not items:
                continue
            t = terms.get(addr)
            if not t or t.get("state") != "live":
                # The terminal is gone: drop what was waiting for it.
                if t is None or t.get("state") == "finished":
                    for f, _ in items:
                        f.unlink(missing_ok=True)
                continue
            due = [(f, m) for f, m in items if m.get("not_before", 0) <= now_ms()]
            if not due:
                continue
            urgent = [x for x in due if x[1].get("urgent")]
            idle = is_agent(t) and t.get("status") not in ("working", "blocked")
            recently = time.time() - self.last_sent.get(addr, 0) < 6
            batch = urgent if (urgent and not idle) else (due if idle and not recently else [])
            if not batch:
                continue
            text = batch[0][1]["text"] if len(batch) == 1 else \
                "Messages that came in while you were busy:\n\n" + "\n\n".join(m["text"] for _, m in batch)
            try:
                send_now(addr, text)
            except DraftInTheWay:
                # Someone's typing in that box: keep the messages until it's sent or cleared.
                if addr not in self.drafts:
                    bot, ch = split_where(t.get("where"))
                    self.drafts[addr] = {"bot": bot, "channel": ch, "since": now_ms()}
                    feed("draft", terminal=addr, bot=bot, channel=ch, held=len(batch))
                    log(f"holding {len(batch)} message(s) for {bot} #{ch}: unsent text in its input box")
                    self.save_health()
                continue
            except CrewError as e:
                log(f"couldn't deliver to {addr}: {e}")
                continue
            if self.drafts.pop(addr, None) is not None:
                self.save_health()
            self.last_sent[addr] = time.time()
            for f, m in batch:
                f.unlink(missing_ok=True)
                if m.get("delegation"):
                    self.delivered(m["delegation"])

    def delivered(self, did):
        path = DATA / "crew-delegations.json"
        with locked("delegations"):
            dels = load_json(path, [])
            for d in dels:
                if d.get("id") == did:
                    d["delivered_at"] = now_ms()
            save_json(path, dels)

    # ── stuck channels ──
    def stalls(self, terms):
        import hashlib
        changed = False
        for addr, t in terms.items():
            if not is_agent(t) or t.get("status") != "working":
                self.shots.pop(addr, None)
                continue
            # Ignore what ticks on its own: spinners, timers, token counts.
            lines = [l for l in meaningful(screen(addr)) if not re.search(r"\d+s\b|\d+m\b|tokens|…|\.\.\.", l)]
            h = hashlib.sha1("\n".join(lines).encode()).hexdigest()
            prev = self.shots.get(addr)
            if not prev or prev[0] != h:
                self.shots[addr] = (h, time.time())
                continue
            if time.time() - prev[1] >= STALL_MIN * 60 and addr not in self.stalled:
                bot, ch = split_where(t.get("where"))
                self.stalled[addr] = {"since": int(prev[1] * 1000), "bot": bot, "channel": ch}
                changed = True
                feed("stalled", terminal=addr, bot=bot, channel=ch, minutes=STALL_MIN)
                log(f"{bot} #{ch} looks stuck")
                self.tell_head(f"[pal] {bot} #{ch} looks stuck: it's been working for {STALL_MIN}+ minutes "
                                   f"without its screen changing. Peek at it (pal peek \"{bot}#{ch}\"). If it's really stuck, "
                                   f"nudge it with pal tell --now; if it's waiting on something long, leave it. "
                                   f"Tell {OWNER} only if it needs them.", exclude=addr)
        if changed:
            self.save_health()

    def notebook_nudge(self, addr, st, bot, ch):
        """A channel that was stuck is moving again: one line asking what was missing, for its notebook.
        At most once an hour per channel; delivered when its turn ends, like any message."""
        try:
            mins = int((now_ms() - (st or {}).get("since", now_ms())) / 60000)
            last = self.nudged.get(addr, 0) if hasattr(self, "nudged") else 0
            if not hasattr(self, "nudged"):
                self.nudged = {}
            if mins < 15 or time.time() - last < 3600:
                return
            self.nudged[addr] = time.time()
            enqueue(addr, f"You were stuck about {mins}m in #{ch}. If something was missing (a tool, a skill, a rule, context, "
                          f"access), note it: pal notebook hiccup \"what got in the way (cost: ~{mins}m)\" --needed \"kind: …\"",
                    sender="crewd", kind="notebook")
        except Exception as e:
            log(f"notebook nudge for {bot} #{ch} failed: {e}")

    def save_health(self):
        save_json(DATA / "crew-health.json", {"stalled": self.stalled, "trust": self.trust, "drafts": self.drafts})

    # ── Claude Code's folder-trust question ──
    def trust_prompts(self, terms):
        """A new Claude Code channel in a folder it hasn't seen waits on 'trust this folder?' before
        doing anything. Point the owner (and the head pal) at it once; never answer it for them."""
        changed = False
        for addr in list(self.trust):
            t = terms.get(addr)
            if not t or t.get("state") != "live" or (t.get("turn") or 0) > 1 or not trust_prompt(screen(addr)):
                self.trust.pop(addr)   # answered (or gone)
                changed = True
        for addr, t in terms.items():
            # Not by agent name: until Claude Code reports a status (it hasn't yet, on this question)
            # herdr-core still names the terminal after its shell ("bash"). The question's own wording
            # is specific enough, and only fresh terminals are read.
            if addr in self.trust or t.get("state") != "live":
                continue
            if (t.get("turn") or 0) > 1 or t.get("status") == "working":
                continue   # past its start: the question only comes first
            if time.time() - self.first_seen.setdefault(addr, time.time()) > 10 * 60:
                continue   # been around a while: not a new channel (saves reading every idle screen)
            if not trust_prompt(screen(addr)):
                continue
            bot, ch = split_where(t.get("where"))
            self.trust[addr] = {"bot": bot, "channel": ch, "since": now_ms()}
            changed = True
            feed("trust", terminal=addr, bot=bot, channel=ch)
            log(f"{bot} #{ch} is waiting on Claude Code's folder-trust question")
            self.tell_head(f"[pal] {trust_notice(bot, ch)} Tell {OWNER}; don't answer it yourself.", exclude=addr)
        if changed:
            self.save_health()

    def tell_head(self, text, exclude=None):
        try:
            spaces = herdr_spaces()
        except CrewError:
            return
        recs = records()
        for s in spaces:
            if record_of(s, recs).get("god"):
                for t in s["tabs"]:
                    x = lead(t)
                    if x and x.get("app") and x["terminal"] != exclude:
                        enqueue(x["terminal"], text, sender="crew", kind="alert")
                        return

    # ── memory ──
    def maybe_review(self, addr, t):
        r = self.reviews.get(addr, {})
        turn = t.get("turn") or 0
        if turn - r.get("turn", 0) < REVIEW_EVERY or time.time() - r.get("at", 0) < REVIEW_GAP:
            return
        if not self.busy.acquire(blocking=False):
            return
        self.reviews[addr] = {"turn": turn, "at": time.time()}
        save_json(DATA / "crew-reviews.json", self.reviews)
        threading.Thread(target=self.review, args=(addr, t), daemon=True).start()

    def review(self, addr, t):
        try:
            bot, ch = split_where(t.get("where"))
            text = "\n".join(meaningful(screen(addr, 400)))[-24000:]
            mem = memory_dir(bot)
            current = (mem / "MEMORY.md").read_text() if (mem / "MEMORY.md").exists() else ""
            notes = (mem / "notes" / f"{today()}.md")
            user = (MEMORY / "USER.md").read_text() if (MEMORY / "USER.md").exists() else ""
            skills = "\n".join(f"- {s['name']}: {s['description']}" for s in crewskills.all_skills())
            prompt = f"""You review a coding agent's recent session so its next sessions remember what matters.
The agent is the pal "{bot}" (channel #{ch}), working for {OWNER}.

Already remembered by this pal:
{current or "(nothing yet)"}
{notes.read_text() if notes.exists() else ""}

Already known about {OWNER}:
{user or "(nothing yet)"}

Shared skills that exist:
{skills or "(none)"}

The session (the end of its terminal):
<session>
{text}
</session>

Reply with JSON only, no prose:
{{"facts": [...], "user": [...], "skill": null}}
- facts: 0-5 short durable facts about this project that a future session would want and that aren't remembered yet: decisions made, conventions, where things live, gotchas, what's finished. No play-by-play, nothing temporary. Only what the session actually shows was said or done: never guess at what {OWNER} wants next or what work is pending, and never claim {OWNER} asked for something unless their own words in the session do.
- user: 0-2 durable things about {OWNER} (preferences, how they like to work) newly shown here. Usually empty.
- skill: only if the session worked out a reusable multi-step procedure worth doing the same way again, and no listed skill covers it: {{"name": "kebab-case", "description": "when to use it, one line", "body": "markdown steps"}}. Usually null."""
            out = subprocess.run(["claude", "-p", "--model", REVIEW_MODEL, "--output-format", "text"],
                                 input=prompt, capture_output=True, text=True, timeout=240, cwd=str(DATA))
            m = re.search(r"\{.*\}", out.stdout, re.S)
            if not m:
                log(f"review of {bot} #{ch}: no JSON")
                return
            data = json.loads(m.group(0))
            for f in (data.get("facts") or [])[:5]:
                remember(bot, f, channel=ch)
            for u in (data.get("user") or [])[:2]:
                remember(bot, u, user=True)
            sk = data.get("skill")
            if isinstance(sk, dict) and sk.get("name") and sk.get("body"):
                crewskills.save(sk["name"], sk.get("description", ""), sk["body"], by=f"{bot} #{ch}", learned=True)
                feed("skill", bot=bot, channel=ch, skill=slug(sk["name"]))
            n = len(data.get("facts") or []) + len(data.get("user") or [])
            log(f"reviewed {bot} #{ch}: {n} facts" + (f", skill {sk['name']}" if isinstance(sk, dict) and sk.get('name') else ""))
            if n:
                feed("remembered", bot=bot, channel=ch, count=n)
        except Exception:
            log("review failed:\n" + traceback.format_exc())
        finally:
            self.busy.release()

    def nightly(self):
        """Distill each pal's last week of notes into its MEMORY.md; archive stale learned skills."""
        with self.busy:
            for d in sorted(MEMORY.iterdir()) if MEMORY.exists() else []:
                notes = sorted((d / "notes").glob("*.md"))[-7:] if (d / "notes").exists() else []
                if not d.is_dir() or not notes or (d / ".distilled").exists() and (d / ".distilled").read_text().strip() == today():
                    continue
                current = (d / "MEMORY.md").read_text() if (d / "MEMORY.md").exists() else ""
                prompt = ("Rewrite this pal's long-term memory. Merge in what the daily notes add, drop what's "
                          "outdated or finished, keep it under 2500 characters of plain markdown bullets grouped "
                          "by topic. Reply with the new memory only.\n\nCurrent memory:\n" + (current or "(empty)")
                          + "\n\nDaily notes:\n" + "\n\n".join(n.read_text() for n in notes))
                try:
                    out = subprocess.run(["claude", "-p", "--model", DISTILL_MODEL, "--output-format", "text"],
                                         input=prompt, capture_output=True, text=True, timeout=300, cwd=str(DATA))
                except subprocess.TimeoutExpired:
                    continue
                new = out.stdout.strip()
                if out.returncode != 0 or len(new) < 20:
                    continue
                if current:
                    hist = d / ".history"
                    hist.mkdir(exist_ok=True)
                    (hist / f"MEMORY-{today()}.md").write_text(current)
                (d / "MEMORY.md").write_text(new[:4000] + "\n")
                (d / ".distilled").write_text(today())
                log(f"distilled {d.name}'s memory")
            crewskills.curate(log)


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
    else:
        Crewd().run()
