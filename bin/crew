def opts(rest, flags, bools=()):
    pos, out, i = [], {}, 0
    while i < len(rest):
        a = rest[i]
        if a == "--topic" and "channel" in flags:   # --topic is --channel's new name (0.4.0); both work
            a = "--channel"
        if a.startswith("--") and a[2:] in bools:
            out[a[2:]] = True; i += 1
        elif a.startswith("--") and a[2:] in flags:
            if i + 1 >= len(rest):
                die(f"{a} needs a value")
            out[a[2:]] = rest[i + 1]; i += 2
        elif a == "-n" and "n" in flags:
            out["n"] = rest[i + 1]; i += 2
        elif a.startswith("--"):
            die(f"unknown option {a}. See crew --help")
        else:
            pos.append(a); i += 1
    return pos, out


def ago(ms):
    d = max(0, time.time() - ms / 1000)
    return "now" if d < 60 else f"{int(d // 60)}m ago" if d < 3600 else f"{int(d // 3600)}h ago" if d < 86400 else f"{int(d // 86400)}d ago"


def git_line(folder):
    if not folder or not os.path.exists(os.path.join(folder, ".git")):
        return None
    def g(*a):
        r = subprocess.run(["git", "-C", folder, *a], capture_output=True, text=True, timeout=10)
        return r.stdout.strip() if r.returncode == 0 else ""
    branch = g("branch", "--show-current") or "detached"
    dirty = len([l for l in g("status", "--porcelain").splitlines() if l.strip()])
    last = g("log", "-1", "--format=%s (%cr)")
    return f"git {branch}, {dirty} changed file{'s' if dirty != 1 else ''}" + (f", last commit: {last}" if last else "")


# ── the team ─────────────────────────────────────────────────────────────────────────────────

def watch_for_trust(bot, channel, wait=15):
    """After starting a pal or channel: if Claude Code stops on its folder-trust question, say so
    (it would otherwise look like the pal just never started). Never answers it."""
    want = channel.lstrip("#").lower()
    deadline = time.time() + wait
    while time.time() < deadline:
        time.sleep(3)
        try:
            space = next((s for s in herdr_spaces() if s["name"] == bot), None)
        except CrewError:
            return
        tab = next((t for t in (space or {}).get("tabs", []) if chan(t).lower() == want), None)
        addrs = [x["terminal"] for x in (tab or {}).get("terminals", []) if x and x.get("terminal")]
        for addr in addrs:
            if trust_prompt(screen(addr)):
                print(trust_notice(bot, channel.lstrip("#")))
                return
            info = hc_terminals().get(addr) or {}
            if info.get("status") == "working":
                return   # it got going: no question in the way


def watch_start(bot, channel, brain="its brain", wait=20):
    """After pal topic: wait for the new topic's agent to show up (T24: on an asleep pal it used to
    open a bare shell and say nothing). Claude Code's folder-trust question counts as started (it is,
    and the notice says what it waits for). Returns True when the agent is there."""
    want = channel.lstrip("#").lower()
    deadline = time.time() + wait
    while time.time() < deadline:
        time.sleep(2)
        try:
            space = next((s for s in herdr_spaces() if s["name"] == bot), None)
        except CrewError:
            return True   # can't see Herdr from here: nothing to report either way
        tab = next((t for t in (space or {}).get("tabs", []) if chan(t).lower() == want), None)
        addrs = [x["terminal"] for x in (tab or {}).get("terminals", []) if x and x.get("terminal")]
        live = hc_terminals()
        for addr in addrs:
            if trust_prompt(screen(addr)):
                print(trust_notice(bot, want))
                return True
            if is_agent(live.get(addr)) or (live.get(addr) or {}).get("status") == "working":
                return True
    print(f"{bot} #{want} opened, but no agent is running in it after {wait}s ({brain} didn't start), so its "
          f"brief hasn't been given. Look at that tab, or close it and try again with --harness.")
    return False


def without_chief(spaces, recs):
    """The pals without the Chief: it's the owner's pop-up, not a pal to message, and its screen is
    the owner's conversation. One line says it's there."""
    import crewchief
    chief = crewchief.record(recs)
    if not chief:
        return spaces
    print(f"({chief['name']}, {OWNER}'s chief of staff, is in its pop-up: it takes no messages; it reads, and hands work to {crewchief.inbox_label()})")
    return [s for s in spaces if not crewchief.is_chief_space(s, recs)]


def cmd_bots(spaces):
    if not spaces:
        print('no pals yet: open a space in Herdr, or hire one: pal hire "Name" --folder ~/Projects/x')
        return
    recs = records()
    import crewareas
    areas = crewareas.load()
    me, _ = whoami(spaces)
    spaces = without_chief(spaces, recs)
    for s in sorted(spaces, key=lambda s: not record_of(s, recs).get("god")):
        r = record_of(s, recs)
        apps = [x.get("app") for t in s["tabs"] for x in t.get("terminals", []) if x and x.get("app")]
        brain = max(set(apps), key=apps.count) if apps else "asleep (no agent running)"
        bits = ["HEAD PAL" if r.get("god") else None, r.get("role"), brain, f"on {s['machine']}" if s.get("machine") else None]
        print(f"{s['name']}  ({' · '.join(b for b in bits if b)})" + (f"\n  folder: {s['folder']}" if s.get("folder") else ""))
        # Topics under their areas when the pal has any (pal topic area …), else as they come.
        by_name = {chan(t): t for t in s["tabs"]}
        groups = crewareas.grouped(s["name"], list(by_name), areas)
        for area, names in groups:
            if len(groups) > 1 or area:
                print(f"  {area or 'Unsorted'} ({len(names)})")
            for n in names:
                t = by_name[n]
                x = lead(t)
                mine = "  ← you" if me == f"{s['name']}#{chan(t)}" else ""
                st = (x or {}).get("status") or ("idle" if (x or {}).get("app") else "asleep")
                print(("    " if len(groups) > 1 or area else "  ") + f"#{chan(t)}: {st}" + (f" ({x['terminal']})" if x else " (no terminal)") + mine)


def cmd_topic_area(spaces, args):
    """pal topic area …: a pal's topics filed under areas (crewareas.py). An area is never part of
    an address; these commands only change how topics are listed."""
    import crewareas
    sub = args[0] if args else "ls"
    rest = args[1:]
    pos, o = opts(rest, (), ("json",))

    def pal_of_spec(spec):
        """A pal's exact name from what was typed (a live pal by any of find's rules, else as typed)."""
        try:
            return find(spec.split("#")[0], spaces)[0]["name"]
        except CrewError:
            return " ".join(spec.split("#")[0].split())

    def topics_of(pal):
        s = next((x for x in spaces if norm(x["name"]) == norm(pal)), None)
        return [chan(t) for t in s["tabs"]] if s else []

    if sub == "ls":
        me, _ = whoami(spaces)
        names = [pal_of_spec(pos[0])] if pos else ([me.split("#")[0]] if me else [s["name"] for s in spaces])
        store = crewareas.load()
        if o.get("json"):
            print(json.dumps({n: {"areas": crewareas.of_pal(n, store)["areas"],
                                  "groups": [{"area": a, "topics": ts} for a, ts in crewareas.grouped(n, topics_of(n), store)]} for n in names}, indent=2))
            return
        for n in names:
            rec = crewareas.of_pal(n, store)
            if not rec["areas"]:
                print(f"{n}: no areas yet (make one: pal topic area set \"{n}#<topic>\" \"<Area>\")")
                continue
            print(f"{n}: {len(rec['areas'])} area{'s' if len(rec['areas']) != 1 else ''}")
            shown = set()
            for a, ts in crewareas.grouped(n, topics_of(n), store):
                print(f"  {a or 'Unsorted'} ({len(ts)}): " + (", ".join("#" + t for t in ts) or "none"))
                shown.add(a)
            for a in rec["areas"]:
                if a["name"] not in shown:
                    print(f"  {a['name']} (0)")
    elif sub == "add" and len(pos) >= 2:
        a = crewareas.add(pal_of_spec(pos[0]), " ".join(pos[1:]))
        print(f"{pal_of_spec(pos[0])} has the area {a['name']}")
    elif sub == "set" and len(pos) >= 2 and "#" in pos[0]:
        pal, topic = pal_of_spec(pos[0]), pos[0].split("#", 1)[1]
        live = topics_of(pal)
        if live and not any(norm(t) == norm(topic) for t in live):
            raise CrewError(f"{pal} has no topic #{topic}. Its topics: " + ", ".join("#" + t for t in live))
        topic = next((t for t in live if norm(t) == norm(topic)), topic)
        a = crewareas.file(pal, topic, " ".join(pos[1:]))
        print(f"{pal} #{topic} is under {a['name']}" if a else f"{pal} #{topic} is unsorted")
    elif sub == "rm" and len(pos) >= 2:
        out = crewareas.remove(pal_of_spec(pos[0]), " ".join(pos[1:]))
        print(f"removed the area {out['area']['name']}; {out['topics']} topic{'s' if out['topics'] != 1 else ''} unsorted again (nothing else changed)")
    elif sub == "rename" and len(pos) == 3:
        a = crewareas.rename(pal_of_spec(pos[0]), pos[1], pos[2])
        print(f"the area is now {a['name']}")
    elif sub == "renamed" and len(pos) == 3:   # the app, when it sees a topic's name change
        print("moved" if crewareas.renamed(pal_of_spec(pos[0]), pos[1], pos[2]) else "nothing to move")
    else:
        die("pal topic area ls [Pal] [--json] | add <Pal> <Area> | set <Pal#topic> <Area|none> | rm <Pal> <Area> | rename <Pal> <Area> <New>")


def cmd_overview(spaces, deep=False):
    recs = records()
    me, _ = whoami(spaces)
    terms = hc_terminals()
    health = load_json(DATA / "crew-health.json", {})
    stalled, trust, drafts = health.get("stalled", {}), health.get("trust", {}), health.get("drafts", {})
    waiting = []
    print(f"# The Project Pals, {time.strftime('%a %d %b %H:%M')}" + ("" if daemon_alive() else "  (crewd isn't running: no queue, routines or callbacks)") + "\n")
    spaces = without_chief(spaces, recs)
    for s in sorted(spaces, key=lambda s: not record_of(s, recs).get("god")):
        r = record_of(s, recs)
        apps = [x.get("app") for t in s["tabs"] for x in t.get("terminals", []) if x and x.get("app")]
        brain = max(set(apps), key=apps.count) if apps else "asleep"
        bits = ["head pal" if r.get("god") else None, r.get("role"), brain, f"on {s['machine']}" if s.get("machine") else None]
        print(f"## {s['name']} ({' · '.join(b for b in bits if b)})")
        if s.get("folder"):
            gl = None if s.get("machine") else git_line(s["folder"])
            print(f"project: {s['folder']}" + (f" ({gl})" if gl else ""))
        mem = memory_dir(s["name"]) / "MEMORY.md"
        if (r.get("memory") or "").strip():
            print("pinned memory: " + " ".join(r["memory"].split())[:300])
        if mem.exists():
            print("memory: " + " ".join(mem.read_text().split())[:300 if not deep else 1200])
        for t in s["tabs"]:
            x = lead(t)
            ch = chan(t)
            info = term_info(x["terminal"]) if x else {}
            st = info.get("status") or {}
            live = x and is_agent(terms.get(x["terminal"]))
            state = st.get("state") or (x or {}).get("status") or ("idle" if live else "asleep")
            briefs = r.get("briefs") or {}
            brief = briefs.get(t["id"]) or briefs.get(t["name"]) or briefs.get("#" + ch)
            wt = (r.get("worktrees") or {}).get(t["name"]) or (r.get("worktrees") or {}).get("#" + ch)
            mine = " (you)" if me == f"{s['name']}#{ch}" else ""
            flag = " · LOOKS STUCK" if x and x["terminal"] in stalled else ""
            print(f"- #{ch}{mine}: {state}{flag}" + (f", on: {st['msg']}" if st.get("msg") else "")
                  + (f" [{x['terminal']}]" if x else " [no terminal]") + (f" · branch {wt['branch']}" if wt else ""))
            if brief:
                print(f"    brief: {' '.join(brief.split())[:200]}")
            if state in ("blocked", "done"):
                waiting.append(f"{s['name']} #{ch} {'has a question' if state == 'blocked' else 'finished'}")
            if live and not mine and (deep or state in ("working", "blocked", "done")):
                for l in meaningful(screen(x["terminal"]))[-(8 if deep else 4):]:
                    print(f"    | {l[:160]}")
        print()
    board = crewtasks.load()["tasks"]
    open_tasks = [t for t in board if t["status"] in crewtasks.OPEN]
    print("## Tasks")
    print("\n".join("- " + crewtasks.line(t) for t in open_tasks) or "(none open)")
    done_recent = [t for t in board if t["status"] == "done" and now_ms() - t["updated"] < 86400 * 1000]
    if done_recent:
        print("done in the last day: " + ", ".join(f"{t['id']} {t['title']}" for t in done_recent))
    print("\n## Rooms")
    metas = sorted(ROOMS.glob("*.json")) if ROOMS.exists() else []
    if not metas:
        print("(none)")
    for m in metas:
        meta = load_json(m, None)
        if not meta:
            continue
        people = ", ".join(f"{x['bot']} #{x.get('channel')}" for x in meta.get("members", []))
        print(f"- #{m.stem}" + (f" (goal: {meta['goal'][:120]})" if meta.get("goal") else "") + f": {people}")
        log = m.with_suffix(".jsonl")
        if log.exists():
            for line in log.read_text().splitlines()[-(6 if deep else 3):]:
                e = json.loads(line) if line.strip().startswith("{") else {}
                print(f"    {e.get('from', '?')}: {' '.join((e.get('text') or '').split())[:160]}")
    rs = crewroutines.load()
    if rs:
        print("\n## Routines")
        for r in rs:
            last = r.get("last") or {}
            print(f"- {r['id']} {r['name']} · {r['bot']} #{r['channel']} · {crewroutines.describe(r['rule'])}"
                  + (" · paused" if r.get("paused") else "") + (f" · last: {last.get('status')} {ago(last['at'] * 1000)}" if last.get("at") else ""))
    pend = [a for a in crewguard.all_requests() if a["status"] == "pending"]
    print(f"\n## Waiting on {OWNER}")
    for a in pend:
        waiting.append(f"approval {a['id']}: {a['bot']} wants to {wants_to(a['why'] or a['rule'])}: {a['command'][:120]}")
    for v in drafts.values():
        waiting.append(f"{v['bot']} #{v['channel']} has unsent text in its input box, so messages to it are held "
                       f"(since {ago(v['since'])}); send or clear it")
    for v in trust.values():
        waiting.append(f"{v['bot']} #{v['channel']} is waiting for you to answer Claude Code's 'trust this folder?' question in that tab")
    for t, v in stalled.items():
        waiting.append(f"{v['bot']} #{v['channel']} looks stuck (working, screen unchanged since {ago(v['since'])})")
    print("\n".join(f"- {w}" for w in waiting) or "(nothing)")


def cmd_feed(spaces, show_all, n):
    me, name = whoami(spaces)
    who = me or f"{OWNER}"
    cursors = load_json(DATA / "crew-feed-cursors.json", {})
    since = 0 if show_all else cursors.get(who, now_ms() - 6 * 3600 * 1000)
    lines = FEED.read_text().splitlines() if FEED.exists() else []
    # "working" (a turn starting) only bounds the Computer's calendar blocks; the feed shows "finished".
    events = [e for e in (json.loads(l) for l in lines if l.strip()) if e.get("at", 0) > since and e.get("kind") != "working"][-n:]
    for e in events:
        k = e["kind"]
        where = f"{e.get('bot', '')}" + (f" #{e['channel']}" if e.get("channel") else "")
        what = {"finished": f"{where} finished a turn", "blocked": f"{where} has a question for {OWNER}",
                "stalled": f"{where} looks stuck", "trust": f"{where} is waiting on the 'trust this folder?' question",
                "draft": f"{where}: messages held, unsent text in its input box",
                "task": f"task {e.get('task')} {e.get('status')}: {e.get('title', '')}",
                "routine": f"routine {e.get('routine')} ({e.get('bot')}): {e.get('status')}",
                "approval": f"approval {e.get('id')} {e.get('status')}: {where} {e.get('command', '')[:80]}",
                "approval-refused": f"approval {e.get('id')}: a {e.get('wanted')} came after it was already {e.get('status')}; nothing changed",
                "remembered": f"{where} remembered {e.get('count')} things", "skill": f"{where} saved skill {e.get('skill')}",
                "proposal": f"proposal {e.get('id')} ({e.get('what')}, {e.get('bot')}): {e.get('status')}"}.get(k, k)
        print(f"{time.strftime('%H:%M', time.localtime(e['at'] / 1000))} {what}")
    if not events:
        print("(nothing new)")
    with locked("feed"):
        cursors = load_json(DATA / "crew-feed-cursors.json", {})
        cursors[who] = now_ms()
        save_json(DATA / "crew-feed-cursors.json", cursors)


def cmd_peek(spaces, spec, n):
    space, tab = find(spec, spaces)
    x = lead(tab)
    if not x:
        die(f"{space['name']} #{chan(tab)} has no terminal")
    st = (term_info(x["terminal"]).get("status") or {})
    state = st.get("state") or x.get("status") or "idle"
    print(f"── {space['name']} #{chan(tab)} ({state}{', ' + st['kind'] if st.get('kind') else ''}) ──")
    lines = [l.rstrip() for l in screen(x["terminal"], n)]
    print("\n".join(lines))
    q = waiting_question(st, screen(x["terminal"]) if state == "blocked" else lines)
    if q:
        print("\n" + q)


def waiting_question(status, live):
    """What a pal is stuck on, from Herdr's status and the live screen (not history): the trust
    question, or a blocked prompt's message and its numbered options. None when it isn't waiting."""
    if trust_prompt(live):
        return (f"── waiting on Claude Code's 'trust this folder?' question. Only {OWNER} answers this one, "
                f"in that tab. ──")
    if status.get("state") != "blocked":
        return None
    # A long option wraps onto indented lines below it (Claude Code 2.1's "2. Yes, and always allow
    # access to <folder> from / this project", seen live 2026-11-09): join them onto the option.
    opts, indent = [], None
    for l in live[-25:]:
        m = re.match(r"^(\s*[❯›>]?\s*)\d+[.)]\s+\S", l)
        if m:
            opts.append(l.strip().lstrip("❯›>").strip())
            indent = len(m.group(1))
        elif opts and indent is not None and l.strip() and len(l) - len(l.lstrip()) > indent:
            opts[-1] += " " + l.strip()
        else:
            indent = None
    out =["── blocked" + (f" on a {status['kind']} prompt" if status.get("kind") else "") + " ──"]
    if status.get("msg"):
        out.append(f"asks: {status['msg']}")
    if opts:
        out.append("options: " + " | ".join(opts))
    out.append(f"It needs {OWNER} to answer in its tab; a message from another pal isn't {OWNER}'s answer.")
    return "\n".join(out)


# ── talking ──────────────────────────────────────────────────────────────────────────────────

def target(spaces, spec):
    space, tab = find(spec, spaces)
    x = lead(tab)
    if not x:
        die(f"{space['name']} #{chan(tab)} has no terminal")
    if x["terminal"] == ME:
        die("that's you")
    if x["terminal"] not in live_agents():
        die(f"{space['name']} #{chan(tab)} is asleep (no agent running there). Wake it: pal wake \"{space['name']}#{chan(tab)}\", "
            f"or invite it to a room, or give it a fresh topic: pal topic \"{space['name']}\" <name> --brief \"...\"")
    return space, tab, x["terminal"]


def cmd_tell(spaces, spec, text, now=False):
    import crewchief
    crewchief.refuse_target(spec, "messages")
    space, tab, t = target(spaces, spec)
    who = crewdesk.sender(spaces)
    me, name = who["me"], who["name"]
    title, body = crewdesk.split_text(text)
    card = crewdesk.create("tell", f"{space['name']}#{chan(tab)}", title, body, frm=who["from"], from_kind=who["from_kind"],
                           proof=who["proof"], urgency="soon" if now else "normal", via="pal tell")
    did = None
    if me:
        did = new_id("d-")
        with locked("delegations"):
            dels = load_json(DATA / "crew-delegations.json", [])
            dels.append({"id": did, "from": ME, "from_name": name, "to": t, "text": text, "at": now_ms(), "card": card["id"],
                         "delivered_at": None if daemon_alive() else now_ms()})
            save_json(DATA / "crew-delegations.json", dels)
    card, _, what = crewdesk.deliver(card, spaces, urgent=now, delegation=did)
    if what.startswith("held"):
        print(f"{what} · card {card['id']} waits on its desk (pal desk sent)")
        return
    status = (term_info(t).get("status") or {}).get("state")
    when = "now" if now or status != "working" or not daemon_alive() else "between its steps, or when its turn ends"
    print(f"told {space['name']} #{chan(tab)} ({when}) · card {card['id']}" + ("; you'll hear back when it finishes" if me and daemon_alive() else ""))


def cmd_ask(spaces, spec, text, timeout):
    import crewchief
    crewchief.refuse_target(spec, "questions")
    space, tab, t = target(spaces, spec)
    deadline = time.time() + timeout
    who = crewdesk.sender(spaces)
    me, name = who["me"], who["name"]
    head = crewdesk.who({"from": who["from"], "from_kind": who["from_kind"]}) if who["from_kind"] != "owner" else header(me, name)
    title, body = crewdesk.split_text(text)
    card = crewdesk.create("ask", f"{space['name']}#{chan(tab)}", title, body, frm=who["from"], from_kind=who["from_kind"],
                           proof=who["proof"], via="pal ask")
    text = crewdesk.escape_body(text)
    import crewchat
    from crewlib import QUEUE, hooked
    status = lambda: (term_info(t).get("status") or {}).get("state")
    started = False
    midturn = status() == "working" and hooked(t) and daemon_alive()
    if midturn:
        # Busy, with delivery hooks: they hand it the question mid-turn, so ask now instead of
        # waiting the whole turn out; its answer starts once the hook has taken the message.
        before = term_info(t).get("turn", 0)
        item = enqueue(t, crewdesk.frame(card), sender=name, kind="ask", meta={"card": card["id"]})
        f = QUEUE / t / f"{item['at']}-{item['id']}.json"
        sent_at = now_ms()
        while (f.exists() or f.with_name(f.name + ".taken").exists()) and time.time() < deadline:
            sent_at = now_ms()   # last moment it was still waiting: its answer comes after this
            time.sleep(0.1)
        if f.exists():   # never handed over (a draft in the way, or it's blocked): don't leave it behind
            from crewlib import claim_queue, finish_claimed
            finish_claimed(claim_queue(t, only=[f]))
            crewdesk.mark(card["id"], "expired", "pal ask", "pal ask", f"not taken within {timeout}s")
            die(f"{space['name']} #{chan(tab)} didn't take the question within {timeout}s; nothing was sent")
    else:
        while status() == "working" and time.time() < deadline:
            time.sleep(2)
        if status() == "blocked":
            die(f"{space['name']} #{chan(tab)} is waiting on {OWNER}'s answer to a question; don't type into it")
        before = term_info(t).get("turn", 0)
        linked = t in crewchat.links()
        sent_at = now_ms()
        try:
            send_now(t, f"{head} asks ({card['id']}): {text}" + ("" if linked else f"\n(Answer right here in your reply; {name} is reading your screen.)"))
        except CrewError:
            crewdesk.mark(card["id"], "cancelled", "pal ask", "pal ask", "couldn't type it in")
            raise
        crewdesk.delivered(card["id"], t, "typed")
    last, still, idle = None, 0, 0
    def card_reply():
        try:
            c = crewdesk.read(crewdesk.need(card["id"]))
            return c.get("reply") if c.get("status") == "done" else None
        except (CrewError, OSError):
            return None
    while time.time() < deadline:
        if card_reply():
            break
        info = term_info(t)
        state = (info.get("status") or {}).get("state")
        if state == "working" or info.get("turn", 0) > before:
            started = True
        if midturn:
            # It answers and carries on with its own work: return once the answer stops growing
            # (or its turn ends), not when the whole turn does.
            reply = crewchat.replies_since(t, sent_at)
            still = still + 1 if reply and reply == last else 0
            last = reply
            idle = idle + 1 if state != "working" else 0
            if still >= 4 or (idle >= 2 and reply) or idle >= 4:
                break
        elif started and state != "working":
            break
        time.sleep(1.5)
    else:
        print(f"(still working after {timeout}s; its screen so far:)")
    reply = card_reply() or crewchat.replies_since(t, sent_at)   # the hooks may have linked it during this turn
    if reply:
        try:
            if not card_reply():
                crewdesk.mark(card["id"], "done", "Project Pals", "session file", "answered (auto)", reply=reply[:8000])
        except CrewError:
            pass
        print(f"── {space['name']} #{chan(tab)} ──")
        print(reply)
        return
    out = screen(t, 200)
    at = max((i for i, l in enumerate(out) if f"{head} asks" in l or f"Desk card {card['id']}" in l), default=-1)
    answer = [l for l in meaningful(out[at + 1:]) if "Answer right here" not in l and "Worked for" not in l and "Crunched for" not in l]
    print(f"── {space['name']} #{chan(tab)} ──")
    print("\n".join(answer[-60:]) or "(no answer on its screen)")


# ── hiring (carried out by the Project Pals layout) ─────────────────────────────────────────────────

def wants_to(why):
    """An approval reason ("makes a release") after "wants to": its first verb in the base form."""
    verb, _, rest = (why or "").strip().partition(" ")
    base = verb[:-2] if re.search(r"(sh|ch|ss|x)es$", verb) else verb[:-1] if re.search(r"[^s]s$", verb) else verb
    return f"{base} {rest}".strip()


def request(op, spaces, **fields):
    me, name = whoami(spaces)
    REQS.mkdir(parents=True, exist_ok=True)
    rid = f"{int(time.time())}-{new_id()}"
    tmp = REQS / f"{rid}.tmp"
    tmp.write_text(json.dumps({"op": op, "by": me, "byName": name, **{k: v for k, v in fields.items() if v not in (None, "", False)}}))
    tmp.rename(REQS / f"{rid}.req.json")
    result = REQS / f"{rid}.result.json"
    deadline = time.time() + 60
    while time.time() < deadline:
        if result.exists():
            try:
                out = json.loads(result.read_text())
            except ValueError:
                time.sleep(0.2)
                continue
            result.unlink(missing_ok=True)
            if not out.get("ok"):
                die(out.get("error") or "it didn't work")
            return out
        time.sleep(0.4)
    if (REQS / f"{rid}.req.json").exists():
        (REQS / f"{rid}.req.json").unlink(missing_ok=True)
        die("the Project Pals layout didn't answer. Is Herdr open on the Project Pals layout?")
    die("Project Pals took the request but hasn't finished; check Herdr")


def git(folder, *args, check=True):
    r = subprocess.run(["git", "-C", folder, *args], capture_output=True, text=True, timeout=120)
    if check and r.returncode != 0:
        raise CrewError(f"git {' '.join(args)}: {(r.stderr or r.stdout).strip()}")
    return r.stdout.strip()


def make_worktree(space, name, base=None):
    folder = space.get("folder")
    if space.get("machine"):
        raise CrewError("worktree topics are for pals on this computer for now")
    if not folder:
        raise CrewError(f"{space['name']} has no project folder")
    repo = git(folder, "rev-parse", "--show-toplevel")
    base = base or git(repo, "branch", "--show-current") or "HEAD"
    branch = f"crew/{slug(name)}"
    existing = git(repo, "branch", "--list", branch)
    n = 2
    while existing:
        branch = f"crew/{slug(name)}-{n}"
        existing = git(repo, "branch", "--list", branch)
        n += 1
    path = WORKTREES / slug(space["name"]) / branch.split("/", 1)[1]
    path.parent.mkdir(parents=True, exist_ok=True)
    git(repo, "worktree", "add", "-b", branch, str(path), base)
    return {"path": str(path), "branch": branch, "base": base, "repo": repo}


def worktree_of(space, tab):
    r = record_of(space)
    wts = r.get("worktrees") or {}
    wt = wts.get(tab["name"]) or wts.get("#" + chan(tab))
    if not wt:
        raise CrewError(f"{space['name']} #{chan(tab)} doesn't have its own branch (make one with pal topic … --worktree)")
    return wt


def diff_data(wt):
    p = wt["path"]
    mb = git(p, "merge-base", wt["base"], "HEAD")
    files = []
    for l in git(p, "diff", "--numstat", mb).splitlines():
        a, r_, f = l.split("\t", 2)
        files.append({"path": f, "added": int(a) if a.isdigit() else 0, "removed": int(r_) if r_.isdigit() else 0})
    untracked = [l for l in git(p, "ls-files", "--others", "--exclude-standard").splitlines() if l]
    return {"branch": wt["branch"], "base": wt["base"], "path": p, "files": files, "untracked": untracked,
            "commits": git(p, "log", "--oneline", f"{mb}..HEAD").splitlines(), "patch": git(p, "diff", mb),
            "dirty": bool(git(p, "status", "--porcelain"))}


def cmd_diff(spaces, spec, mode):
    space, tab = find(spec, spaces)
    d = diff_data(worktree_of(space, tab))
    if mode == "json":
        print(json.dumps(d))
        return
    print(f"{space['name']} #{chan(tab)}: {d['branch']} vs {d['base']}, {len(d['commits'])} commit(s)"
          + (", uncommitted changes" if d["dirty"] else ""))
    for f in d["files"]:
        print(f"  {f['path']} +{f['added']} -{f['removed']}")
    for f in d["untracked"]:
        print(f"  {f} (new, not added)")
    if mode != "stat":
        print(d["patch"])


def cmd_land(spaces, spec, check=None):
    space, tab = find(spec, spaces)
    # A pal asking: the owner approves first (Claude pals are held by the hook; this covers the rest).
    # Anyone else is the owner only with a click in Project Pals (Review's Land): a missing or unknown
    # terminal ID isn't the owner (Grok review H1).
    if ME and is_bot_terminal(ME):
        if not crewguard.recently_used(ME, "land"):
            s, t = where_of(ME, spaces)
            held = crewguard.check(ME, s["name"] if s else "?", chan(t) if t else "?", f"pal land {spec}")
            if held:
                die(f"held for {OWNER}'s approval ({held['id']}); you'll be told when it's decided")
    else:
        require_owner("landing a branch")
    wt = worktree_of(space, tab)
    if git(wt["path"], "status", "--porcelain"):
        die(f"{space['name']} #{chan(tab)} has uncommitted changes; ask it to commit (or discard) them first")
    repo = wt["repo"]
    with locked(f"land-{slug(repo)}"):  # one landing per project at a time: a simple merge queue
        if git(repo, "branch", "--show-current") != wt["base"]:
            die(f"{repo} isn't on {wt['base']}; switch it back before landing")
        if [l for l in git(repo, "status", "--porcelain", "--untracked-files=no").splitlines() if l]:
            die(f"{repo} has uncommitted changes of its own; commit or stash them before landing")
        if check:
            r = subprocess.run(["sh", "-c", check], cwd=wt["path"], capture_output=True, text=True, timeout=1800)
            if r.returncode != 0:
                die(f"the check failed, so nothing was landed:\n" + "\n".join((r.stdout + r.stderr).strip().splitlines()[-30:]))
        r = subprocess.run(["git", "-C", repo, "merge", "--no-ff", wt["branch"], "-m",
                            f"Land {wt['branch']} ({space['name']} #{chan(tab)})"], capture_output=True, text=True)
        if r.returncode != 0:
            subprocess.run(["git", "-C", repo, "merge", "--abort"], capture_output=True)
            conflicts = (r.stdout + r.stderr).strip()
            x = lead(tab)
            if x:
                try:
                    enqueue(x["terminal"], f"[pal] Your branch {wt['branch']} couldn't land on {wt['base']}: it conflicts. "
                            f"Rebase it on {wt['base']} (git rebase {wt['base']}), fix the conflicts, commit, and say when it's ready.",
                            sender="crew", kind="land")
                except CrewError:
                    pass
            die(f"couldn't land {wt['branch']}: it conflicts with {wt['base']} (merge aborted, nothing changed). "
                f"The topic was asked to rebase.\n{conflicts[-800:]}")
    x = lead(tab)
    if x:
        try:
            enqueue(x["terminal"], f"[pal] Your branch {wt['branch']} landed on {wt['base']}.", sender="crew", kind="land")
        except CrewError:
            pass
    append_jsonl(FEED, {"at": now_ms(), "kind": "landed", "bot": space["name"], "channel": chan(tab), "branch": wt["branch"]})
    print(f"landed {wt['branch']} on {wt['base']} in {repo}")


# ── sleeping and waking (in place: the topic's tab and shell stay; bin/crewsleep.py has the safety) ──

def _room_seats():
    seats = set()
    for f in ROOMS.glob("*.json") if ROOMS.exists() else ():
        seats |= {m.get("terminal") for m in (load_json(f, None) or {}).get("members") or [] if m.get("terminal")}
    return seats


def _targets(spec, spaces):
    """'Pal#topic' or '#topic' → [(space, tab)]; 'Pal' → its tabs, or every pal whose name starts with it
    (an exact name wins: 'navi-Jefe' doesn't also take 'navi-Jefe-2')."""
    if spec.startswith("#"):
        want = spec[1:].lower()
        mine, _ = where_of(ME, spaces) if ME else (None, None)
        hits = [(s, t) for s in spaces for t in s["tabs"] if chan(t).lower() == want]
        hits = [h for h in hits if h[0] is mine] or hits
        if len(hits) != 1:
            raise CrewError(f"#{want}: " + (f"in {', '.join(s['name'] for s, _ in hits)}; say Pal#{want}" if hits else "no such topic"))
        return hits
    if "#" in spec:
        return [find(spec, spaces)]
    low = spec.lstrip("@").lower()
    if not low:
        raise CrewError("name a pal")
    group = ([s for s in spaces if s["name"].lower() == low]
             or [s for s in spaces if s["name"].lower().startswith(low)] or [find(spec, spaces)[0]])
    return [(s, t) for s in group for t in s["tabs"]]


def _tell_app(mode, lines, refused):
    """--notify (the menus run pal detached): the outcome as a toast, through the app's request queue.
    Best effort: a few seconds, then the request is taken back."""
    if not lines:
        return
    rid = f"{int(time.time())}-{new_id()}"
    try:
        REQS.mkdir(parents=True, exist_ok=True)
        tmp = REQS / f"{rid}.tmp"
        tmp.write_text(json.dumps({"op": "power-report", "mode": mode, "lines": lines[:12], "refused": bool(refused)}))
        tmp.rename(REQS / f"{rid}.req.json")
    except OSError:
        return
    deadline = time.time() + 8
    while time.time() < deadline and not (REQS / f"{rid}.result.json").exists():
        time.sleep(0.3)
    (REQS / f"{rid}.result.json").unlink(missing_ok=True)
    (REQS / f"{rid}.req.json").unlink(missing_ok=True)


def _stop_tab(space, tab, terms, dry=False, quiet=False, out=None, head=False):
    """Put one topic's agent to sleep and keep its shell. Returns 'slept', 'asleep' or 'refused'."""
    import crewsleep, crewchat
    loud = lambda m: (print(m), out is not None and out.append(m))
    say = (lambda m: None) if quiet else loud   # --idle says nothing about the topics it leaves alone
    label = f"{space['name']} #{chan(tab)}"
    if head and not owner_proven():
        # The head pal oversees the rest: only the owner's click (its menu) puts it to sleep (Grok T50).
        say(f"not putting {label} to sleep: it's the head pal; only {OWNER}'s click in Project Pals does that")
        return "refused"
    addr = (lead(tab) or {}).get("terminal")
    info = term_info(addr) if crewsleep.is_local(space, addr) and addr != ME else {}
    try:
        shell, agent = crewsleep.check_sleep(space, addr, ME, info, screen(addr, 60) if info else [])
    except crewsleep.Refused as e:
        say(f"not putting {label} to sleep: {e}")
        return "refused"
    if agent is None:
        if not dry and shell_is_bare(shell) and ((info.get("status") or {}).get("app") or is_agent(terms.get(addr) or {})):
            clear_osc_status(shell)   # agy leaves its status behind when it exits
            (HOOKED / addr).unlink(missing_ok=True)
        say(f"{label}: already asleep")
        return "asleep"
    app = (info.get("status") or {}).get("app") or proc_comm(agent)
    if dry:
        loud(f"would put {label} to sleep ({app}, {addr})")
        return "slept"
    # Looked at once more right before the signal: a message may have just started a turn.
    st = (term_info(addr).get("status") or {}).get("state")
    if st in ("working", "blocked"):
        say(f"not putting {label} to sleep: it just became {st}")
        return "refused"
    crewsleep.mark_slept(addr, pal=space["name"], topic=chan(tab), app=app, link=crewchat.links().get(addr))
    try:
        how = crewsleep.stop_agent(agent, shell, addr)
    except crewsleep.Refused as e:
        crewsleep.unmark(addr)
        loud(f"couldn't put {label} to sleep: {e}")
        return "refused"
    clear_osc_status(shell)
    (HOOKED / addr).unlink(missing_ok=True)
    loud(f"put {label} to sleep ({app}, {addr})" + (" (it needed KILL)" if how == "kill" else ""))
    return "slept"


def cmd_sleep(spaces, rest):
    """pal sleep <Pal|Pal#topic|#topic>... | --idle [-n] [--notify]"""
    if "--force" in rest:
        die("pal sleep has no --force: a pal that's mid-turn, waiting on a prompt, typing, or running work "
            "isn't put to sleep. Let it finish (or stop that work), then sleep it.")
    pos, o = opts([a for a in rest if a != "-n"], (), ("idle", "notify"))
    dry = "-n" in rest
    if not pos and not o.get("idle"):
        die("pal sleep <Pal[#topic]|#topic>... | --idle [-n]")
    recs, terms, out = records(), hc_terminals(), []
    named = []
    for spec in pos:
        try:
            named += _targets(spec, spaces)
        except CrewError as e:
            print(f"{spec}: {e}"); out.append(f"{spec}: {e}")
    # --idle sweeps every topic but the head pal's, quietly: it says nothing about the ones it leaves.
    swept = [(s, t) for s in spaces if not record_of(s, recs).get("god") for t in s["tabs"]] if o.get("idle") else []
    seen, n, refused = set(), 0, False
    for (s, t), loud in [(p, True) for p in named] + [(p, False) for p in swept]:
        addr = (lead(t) or {}).get("terminal")
        if addr in seen:
            continue
        seen.add(addr)
        r = _stop_tab(s, t, terms, dry, quiet=not loud, out=out, head=bool(record_of(s, recs).get("god")))
        n += r == "slept"
        refused |= r == "refused"
    if o.get("idle") and not n:
        print("no idle pals to put to sleep")
    if o.get("notify"):
        _tell_app("sleep", out, refused)


def _wake_line(spaces, space, tab, addr, info):
    """(the command to type, what it says about the brain and the session). The brain is T27's pick,
    made by the app (wake-brain): this topic's brain on record, else the pal's command on record,
    else its harness started fresh, else Claude Code."""
    import crewsleep, crewchat
    brain = request("wake-brain", spaces, space=space["id"], tab=tab["id"])
    base = crewsleep.base_argv(brain.get("argv"), brain.get("key"))
    if not base:
        raise crewsleep.Refused("no brain to start for it")
    live = {a for a, t in hc_terminals().items() if is_agent(t)}
    extra, why = crewsleep.resume_args(addr, brain.get("key"), base, crewsleep.shell_cwd(info["pid"], info), crewchat.links(), live)
    hint = [] if extra else ([brain["hint"]] if brain.get("hint") else [])
    said = f"{brain.get('name') or brain.get('key') or 'its brain'}" + (f" ({brain['why']})" if brain.get("why") else "")
    return shlex.join([*base, *extra, *hint]), f"{said}; {why}"


def cmd_wake(spaces, rest):
    """pal wake <Pal|Pal#topic|#topic>... [-n] [--notify]"""
    import crewsleep
    pos, o = opts([a for a in rest if a != "-n"], (), ("notify",))
    dry = "-n" in rest
    if not pos:
        die("pal wake <Pal[#topic]|#topic>... [-n]")
    seats, out, refused = _room_seats(), [], False
    def say(m):
        print(m); out.append(m)
    # Without the caller's own address, so hc send types the command as is (no <hc from=…> wrap).
    # The variables that find the core (HC_SESSION, HC_SOCKET, HC_TERMINAL_SOCKET) stay: without
    # them hc asks the default core, which may not be the one the topic runs on (found live, T41).
    raw_env = {k: v for k, v in os.environ.items() if k not in ("HC_TERMINAL_ID", "HC_SCOPE")}
    for spec in pos:
        try:
            pairs = _targets(spec, spaces)
        except CrewError as e:
            say(f"{spec}: {e}"); refused = True
            continue
        asleep = []
        for s, t in pairs:
            addr = (lead(t) or {}).get("terminal")
            if addr and crewsleep.is_local(s, addr) and not agent_running(addr)[0]:
                asleep.append((s, t, addr))
        if "#" not in spec:
            # A whole pal: the topics pal sleep put to sleep, else its room seats, else one topic
            # (the active one), unless it's already up.
            picked = []
            for sp in {id(p[0]): p[0] for p in pairs}.values():
                xs = [x for x in asleep if x[0] is sp]
                awake = any(agent_running(a)[0] for _, t in pairs if t in sp["tabs"] and (a := (lead(t) or {}).get("terminal")))
                wake = ([x for x in xs if crewsleep.slept(x[2])] or [x for x in xs if x[2] in seats]
                        or ([] if awake else [next((x for x in xs if x[1].get("active")), xs[0])] if xs else []))
                picked += wake
                if not wake:
                    say(f"{sp['name']}: already awake" if awake else f"{sp['name']}: nothing to wake here")
            asleep = picked
        elif not asleep:
            say(f"{spec}: already awake (or on another machine)")
        for s, t, addr in asleep:
            label = f"{s['name']} #{chan(t)}"
            info = term_info(addr)
            try:
                crewsleep.check_wake(s, addr, info)
                line, said = _wake_line(spaces, s, t, addr, info)
            except crewsleep.Refused as e:
                say(f"not waking {label}: {e}"); refused = True
                continue
            if dry:
                say(f"would wake {label} ({addr}) with {said}: {line}")
                continue
            subprocess.run(["hc", "keys", addr, "ctrl+c"], env=raw_env, capture_output=True, timeout=10)
            r = subprocess.run(["hc", "send", "--force", addr, line], env=raw_env, capture_output=True, text=True, timeout=30)
            if r.returncode != 0:
                say(f"couldn't wake {label}: {(r.stderr or r.stdout).strip() or 'hc send failed'}"); refused = True
                continue
            crewsleep.unmark(addr)
            say(f"woke {label} ({addr}) with {said}")
    if o.get("notify"):
        _tell_app("wake", out, refused)


# ── tasks, routines, memory, skills, approvals ───────────────────────────────────────────────

def cmd_task(spaces, rest):
    me, name = whoami(spaces)
    sub, args = (rest[0], rest[1:]) if rest else ("ls", [])
    if sub == "add":
        pos, o = opts(args, ("for", "after", "body", "check", "due"))
        if not pos:
            die('pal task add "<title>" [--for Pal] [--after T1,T2] [--due fri]')
        deps = [d.strip() for d in (o.get("after") or "").split(",") if d.strip()]
        if o.get("for"):
            import crewchief
            crewchief.refuse_target(o["for"], "tasks")
        due = crewtasks.parse_due(o["due"]) if o.get("due") else None
        t = crewtasks.add(" ".join(pos), spaces, me, name, o.get("body"), o.get("for"), deps, o.get("check"), due=due)
        print(f"added {crewtasks.line(t)}")
    elif sub in ("ls", "list"):
        board = crewtasks.load()["tasks"]
        show = board if "--all" in args else [t for t in board if t["status"] in crewtasks.OPEN]
        if "--mine" in args and me:
            show = [t for t in show if crewtasks.same(t.get("assignee") or "", me) or crewtasks.same(t.get("claimed_by") or "", me)]
        print("\n".join(crewtasks.line(t) for t in show) or "(no open tasks)")
    elif sub == "ready":
        board = crewtasks.load()
        ready = [t for t in board["tasks"] if t["status"] == "open"
                 and all(crewtasks.get(board, d)["status"] == "done" for d in t["deps"])
                 and (not t.get("assignee") or (me and crewtasks.same(t["assignee"], me)) or (not me))]
        print("\n".join(crewtasks.line(t) for t in ready) or "(nothing ready for you)")
    elif sub == "show" and args:
        t = crewtasks.get(crewtasks.load(), args[0])
        print(crewtasks.line(t))
        print(f"by {t['by']}, {ago(t['created'])}" + (f"\ncheck: {t['check']}" if t.get("check") else "")
              + (f"\ndue: {t['due']} ({crewtasks.due_label(t['due'])})" if t.get("due") else ""))
        if t["body"]:
            print(t["body"])
        for n in t["notes"]:
            print(f"  {ago(n['at'])} {n['by']}: {n['text']}")
        if t.get("result"):
            print(f"result: {t['result']}")
    elif sub == "claim" and args:
        print("claimed " + crewtasks.line(crewtasks.update(args[0], spaces, me, name, claim=True)))
    elif sub == "note" and len(args) >= 2:
        crewtasks.update(args[0], spaces, me, name, note=" ".join(args[1:]))
        print("noted")
    elif sub == "block" and len(args) >= 2:
        print(crewtasks.line(crewtasks.update(args[0], spaces, me, name, status="blocked", note=" ".join(args[1:]))))
        if me:
            print('What would have unblocked it? Note it: pal notebook hiccup "…" --needed "tool|skill|rule|context|access: …"')
    elif sub == "done" and args:
        result = " ".join(args[1:]) or None
        t = crewtasks.update(args[0], spaces, me, name, status="done", result=result, note=f"done: {result}" if result else None)
        print(crewtasks.line(t))
        # One line in the owning pal's brain change log (who claimed it, else who it was for).
        who = t.get("claimed_by") or t.get("assignee")
        if who:
            try:
                sp, tb = find(who, spaces)
                brain_log(sp, record_of(sp), sp["name"], f"{t['id']} done: {result or t.get('title', '')}", chan(tb) if "#" in who else None)
            except CrewError:
                pass
        if me:
            print('Anything slow along the way? Note it: pal notebook "did: …" --hiccup "… (cost: ~15m)" --lesson "…"')
    elif sub == "assign" and len(args) >= 2:
        import crewchief
        crewchief.refuse_target(args[1], "tasks")
        print(crewtasks.line(crewtasks.update(args[0], spaces, me, name, assignee=args[1])))
    elif sub == "due" and len(args) >= 2:
        # The owner sets any task's due date; a pal only its own (assigned to it, claimed by it, or made by it).
        t = crewtasks.get(crewtasks.load(), args[0])
        if me and not any(crewtasks.same(t.get(k) or "", me) for k in ("assignee", "claimed_by", "by_spec")):
            die(f"{t['id']} isn't yours: only its pal or the owner can set its due date")
        due = crewtasks.parse_due(" ".join(args[1:]))
        print(crewtasks.line(crewtasks.update(t["id"], spaces, me, name, due=due)))
    elif sub == "cancel" and args:
        print(crewtasks.line(crewtasks.update(args[0], spaces, me, name, status="cancelled")))
    elif sub == "reopen" and args:
        print(crewtasks.line(crewtasks.update(args[0], spaces, me, name, status="open")))
    else:
        die("pal task add|ls|ready|show|claim|note|block|done|due|assign|cancel|reopen (see crew --help)")


# ── the Desk (docs/desk/design.md) ────────────────────────────────────────────────────────────

def desk_print(rows, as_json, empty):
    if as_json:
        print(json.dumps({"cards": [crewdesk.summary(c, p) for p, c in rows], "counts": crewdesk.counts(), "pals": crewdesk.by_pal(),
                          "triage": crewdesk.conf().get("triage")}, ensure_ascii=False))
    else:
        print("\n".join(crewdesk.line(c) for _, c in rows) or empty)


def desk_card(cid):
    p = crewdesk.need(cid)
    return p, crewdesk.read(p)


def desk_mine(card, who):
    """Is this card on my desk (any topic of my pal)?"""
    return bool(who["me"]) and crewdesk.pal_of(card.get("to")).lower() == who["name"].lower()


def desk_may(card, who, what, sender_ok=False):
    """Only the card's pal, the owner (a click) and, for cancel, its sender move a card (§10.3)."""
    if who["from_kind"] == "owner" or desk_mine(card, who):
        return
    if sender_ok and (card.get("from") or "").lower() == (who["from"] or "").lower():
        return
    die(f"{card['id']} is on {crewdesk.pal_of(card.get('to')) or 'no'} desk: only that pal or {OWNER} can {what} it")


def desk_to(spaces, spec, who=None):
    """'auto' | 'route' | the owner | 'Pal[#topic]' → (to, auto)."""
    low = (spec or "").lower()
    if low in ("route", "to route", "auto", ""):
        return "", low == "auto"
    if low in (OWNER.lower(), "owner"):
        return OWNER, False
    space, tab = find(spec, spaces)
    to = f"{space['name']}#{chan(tab)}" if "#" in spec else space["name"]
    if who and who.get("me") and to.lower() == who["me"].lower():
        die("that's you")
    return to, False


def desk_text(pos, o):
    text = " ".join(pos)
    if o.get("file"):
        text = (text + "\n" if text else "") + Path(o["file"]).read_text()
    if not text.strip():
        die("what should it say? give the text, or -F file")
    return text


def desk_attachments():
    out = []
    for a in [ARGV[i + 1] for i, x in enumerate(ARGV[:-1]) if x == "--attach"]:
        src = Path(a).expanduser()
        out.append(str(src.resolve()) if (DATA / "crew-attachments").resolve() in src.resolve().parents else desk_attach(src))
    return out


def cmd_desk(spaces, rest):
    sub = rest[0] if rest and not rest[0].startswith("--") else "ls"
    args = rest[1:] if rest and not rest[0].startswith("--") else rest
    who = crewdesk.sender(spaces)
    owner = who["from_kind"] == "owner"
    via = f"pal desk {sub}"
    by = who["from"]
    if sub in ("ls", "list"):
        pos, o = opts(args, (), ("all", "route", "owner", "held", "done", "drafts", "json"))
        where = ("open", "done") if o.get("done") else ("open",)
        rows = crewdesk.cards(where=where)
        if o.get("done"):
            since = time.time() - 7 * 86400
            rows = [(p, c) for p, c in rows if p.parent.name == "open" or crewdesk.parse_iso(c.get("updated")) >= since]
        if o.get("drafts"):
            rows = [(p, c) for p, c in rows if p.parent.parent.name == crewdesk.DRAFTS
                    and (owner or not who["me"] or (c.get("from") or "").lower() == who["me"].lower())]
        elif o.get("route"):
            rows = [(p, c) for p, c in rows if p.parent.parent.name == crewdesk.ROUTE]
        elif o.get("owner"):
            rows = [(p, c) for p, c in rows if p.parent.parent.name == crewdesk.OWNER_TRAY or c.get("status") == "needs you"]
        elif o.get("held"):
            rows = [(p, c) for p, c in rows if c.get("status") == "held"]
        elif not o.get("all") and who["me"]:
            topic = who["me"].partition("#")[2]
            mine = {str(p) for p, _ in crewdesk.mine(who["name"], topic)}
            rows = [(p, c) for p, c in rows if str(p) in mine]
        desk_print(rows, o.get("json"), "(your desk is empty)" if who["me"] and not o.get("all") else "(no open cards)")
    elif sub in ("open", "show") and args:
        pos, o = opts(args, (), ("json",))
        p, card = desk_card(pos[0])
        if desk_mine(card, who) and card.get("status") in ("queued", "held"):
            card = crewdesk.delivered(card["id"], ME, "opened") or card
        if o.get("json"):
            print(json.dumps(crewdesk.summary(card, p), ensure_ascii=False))
            return
        print(crewdesk.frame(card) if desk_mine(card, who) else crewdesk.line(card))
        for a in card.get("attachments") or []:
            print(f"attachment: {DATA / a}")
        if card.get("reply") is not None:
            print("── reply ──\n" + card["reply"])
        print("── receipts ──")
        for r in card.get("receipts", []):
            print(f"  {r['at']} {r['status']} · {r['by']} · {r['via']}" + (f" · {r['note']}" if r.get("note") else ""))
    elif sub == "take" and args:
        pos, o = opts(args, (), ("sub",))
        _, card = desk_card(pos[0])
        desk_may(card, who, "take")
        if card.get("task"):   # the board follows: taking a task's card claims the task
            crewtasks.update(card["task"], spaces, who["me"], who["name"], claim=True, from_card=True)
        card = crewdesk.mark(card["id"], "working", by, via, "handed to a sub-agent" if o.get("sub") else "")
        print(crewdesk.line(card))
        if o.get("sub"):
            print("Give the sub-agent the goal, which files it may change, and that it can't push, release or message people. "
                  f"Close the card yourself when it reports: pal desk done {card['id']} \"result\"")
    elif sub == "later" and args:
        _, card = desk_card(args[0])
        desk_may(card, who, "move")
        print(crewdesk.line(crewdesk.mark(card["id"], "later", by, via, "after the current step")))
    elif sub == "done" and args:
        _, card = desk_card(args[0])
        desk_may(card, who, "close")
        result = " ".join(args[1:]).strip() or None
        if result:
            result = crewdesk.check_text("x", result)[1]
        if card.get("task"):   # the task is done too (its check, if it has one, must pass first)
            crewtasks.update(card["task"], spaces, who["me"], who["name"], status="done", result=result,
                             note=f"done: {result}" if result else None, from_card=True)
        print(crewdesk.line(crewdesk.mark(card["id"], "done", by, via, (result or "")[:200], result=result)))
    elif sub == "reply" and len(args) >= 2:
        _, card = desk_card(args[0])
        desk_may(card, who, "answer")
        answer = crewdesk.check_text("x", " ".join(args[1:]))[1]
        print(crewdesk.line(crewdesk.mark(card["id"], "done", by, via, "answered", reply=answer)))
    elif sub == "block" and len(args) >= 2:
        pos, o = opts(args, (), ("owner",))
        _, card = desk_card(pos[0])
        desk_may(card, who, "block")
        why = " ".join(pos[1:])
        if card.get("task"):
            crewtasks.update(card["task"], spaces, who["me"], who["name"], status="blocked", note=why, from_card=True)
        card = crewdesk.mark(card["id"], "needs you" if o.get("owner") else "blocked", by, via, why[:300])
        print(crewdesk.line(card) + (f"\n{OWNER} sees it in the Inbox." if o.get("owner") else ""))
    elif sub == "pass" and len(args) >= 2:
        _, card = desk_card(args[0])
        desk_may(card, who, "pass")
        to = args[1]
        if to.lower() not in ("route", "to route"):
            space, tab = find(to, spaces)
            to = f"{space['name']}#{chan(tab)}" if "#" in to else space["name"]
        else:
            to = ""
        card = crewdesk.move(card["id"], to, by, via, " ".join(args[2:]) or "")
        card, t, what = crewdesk.deliver(card, spaces)
        print(f"passed {card['id']} to {card['to']}: {what}")
    elif sub == "due" and len(args) >= 2:
        # The owner sets any task's due date; a pal only its own (assigned to it, claimed by it, or made by it).
        t = crewtasks.get(crewtasks.load(), args[0])
        if me and not any(crewtasks.same(t.get(k) or "", me) for k in ("assignee", "claimed_by", "by_spec")):
            die(f"{t['id']} isn't yours: only its pal or the owner can set its due date")
        due = crewtasks.parse_due(" ".join(args[1:]))
        print(crewtasks.line(crewtasks.update(t["id"], spaces, me, name, due=due)))
    elif sub == "cancel" and args:
        _, card = desk_card(args[0])
        desk_may(card, who, "cancel", sender_ok=True)
        if not owner and card.get("status") not in ("queued", "held", "draft"):
            die(f"{card['id']} is {card['status']} already: only {OWNER} can cancel it now")
        print(crewdesk.line(crewdesk.mark(card["id"], "cancelled", by, via)))
    elif sub == "urgency" and len(args) >= 2:
        if not owner:
            require_owner("change a card's urgency")
        if args[1] not in crewdesk.URGENCY:
            die("urgency is low, normal, soon or now")
        _, card = desk_card(args[0])
        print(crewdesk.line(crewdesk.mark(card["id"], f"urgency {args[1]}", by, via, "", urgency=args[1])))
    elif sub == "confirm" and args:
        if not owner:
            require_owner("confirm a card as yours")
        _, card = desk_card(args[0])
        if card.get("from_kind") != "owner":
            die(f"{card['id']} isn't {OWNER}'s card")
        crewdesk.ledger_add(card)
        print(crewdesk.line(crewdesk.mark(card["id"], "confirmed", by, via, f"{OWNER} confirmed the edited card")))
    elif sub == "send" and len(args) >= 1:
        pos, o = opts(args, ("attach", "re", "urgency", "file", "from-draft"), ("soon", "low", "now", "ask", "task", "relaying", "json"))
        if o.get("from-draft") and not owner:
            die(f"only {OWNER} sends an edited draft (from Project Pals)")
        attach = [ARGV[i + 1] for i, a in enumerate(ARGV[:-1]) if a == "--attach"]
        if not pos:
            die('pal desk send <Pal[#topic]|owner|route> "text"')
        text = " ".join(pos[1:])
        if o.get("file"):
            text = (text + "\n" if text else "") + Path(o["file"]).read_text()
        if not text.strip():
            die("send what? pal desk send <to> \"text\" (or -F file)")
        urgency = o.get("urgency") or ("now" if o.get("now") else "soon" if o.get("soon") else "low" if o.get("low") else "normal")
        to = pos[0]
        import crewchief
        auto = to.lower() == "auto"
        if crewchief.caller_is_chief():
            to = crewchief.send_target(to, spaces)   # only ever <head>#ops
            auto = False
        elif to.lower() in ("route", "to route", "auto"):
            to = ""
        elif to.lower() in (OWNER.lower(), "owner"):
            to = OWNER
        else:
            crewchief.refuse_target(to)
            space, tab = find(to, spaces)
            to = f"{space['name']}#{chan(tab)}" if "#" in to else space["name"]
            if who["me"] and to.lower() == who["me"].lower():
                die("that's you")
        if to == OWNER and owner:
            die(f"that's you, {OWNER}")
        if urgency == "soon" and who["from_kind"] == "pal" and to and to != OWNER:
            cap = int(crewdesk.conf().get("pal_soon_per_hour") or 6)
            if crewdesk.soon_count(to) >= cap:
                urgency = "normal"
                print(f"(sent as normal: {to} already had {cap} soon cards from pals this hour)")
        depth, thread = 0, None
        if o.get("re"):
            _, parent = desk_card(o["re"])
            depth, thread = int(parent.get("depth") or 0) + 1, parent.get("thread") or parent["id"]
        kind = "ask" if o.get("ask") else "task" if o.get("task") else "tell"
        title, body = crewdesk.split_text(text)
        task = None
        if o.get("task") and to and to != OWNER:
            t = crewtasks.add(title, spaces, who["me"], who["name"], body or None, to, notify_assignee=False)
            task = t["id"]
        atts = []
        for a in attach:
            src = Path(a).expanduser()
            store = DATA / "crew-attachments"
            if store.resolve() in src.resolve().parents:
                atts.append(str(src.resolve()))
            else:
                atts.append(desk_attach(src))
        card = crewdesk.create(kind, to, title, body, frm=who["from"], from_kind=who["from_kind"], proof=who["proof"],
                               relaying=OWNER if o.get("relaying") and who["from_kind"] == "pal" else None,
                               urgency=urgency, status="needs you" if to == OWNER else "queued", via=via, task=task,
                               thread=thread, depth=depth, reply_to=o.get("re"), attachments=atts,
                               extra={"route": "auto"} if auto else None)
        did = None
        if who["me"] and to and to != OWNER:
            did = new_id("d-")
            with locked("delegations"):
                dels = load_json(DATA / "crew-delegations.json", [])
                dels.append({"id": did, "from": ME, "from_name": who["name"], "to": None, "text": text, "at": now_ms(),
                             "card": card["id"], "delivered_at": None if daemon_alive() else now_ms()})
                save_json(DATA / "crew-delegations.json", dels)
        card, t, what = crewdesk.deliver(card, spaces, urgent=urgency == "now", delegation=did)
        if did:
            with locked("delegations"):
                dels = load_json(DATA / "crew-delegations.json", [])
                for d in dels:
                    if d["id"] == did:
                        d["to"] = t
                save_json(DATA / "crew-delegations.json", [d for d in dels if d.get("to")])
        if o.get("from-draft"):
            try:
                crewdesk.mark(o["from-draft"], "cancelled", by, via, f"edited and sent as {card['id']}")
            except CrewError:
                pass
        if o.get("json"):
            print(json.dumps({"card": crewdesk.summary(card, crewdesk.need(card["id"])), "terminal": t, "what": what}, ensure_ascii=False))
        else:
            print(f"{card['id']} → {card['to']}: {what}")
    elif sub == "sent":
        pos, o = opts(args, ("days",), ("json",))
        desk_print(crewdesk.sent_by(who["from"], int(o.get("days") or 7)), o.get("json"), "(nothing sent in the last week)")
    elif sub == "attach" and args:
        print(desk_attach(Path(args[0]).expanduser()))
    elif sub == "stats":
        pos, o = opts(args, (), ("json",))
        st = crewdesk.stats()
        if o.get("json"):
            print(json.dumps(st))
        else:
            print(", ".join(f"{st[k]} {k}" for k in ("open", "held", "needs you", "to route", "drafts"))
                  + f"; triage {st['triage']}: {st['triage_today']}/{st['triage_cap']} calls today")
    elif sub == "check":
        crewdesk.ensure()
        out = crewdesk.reconcile()
        crewdesk.tidy()
        print("\n".join(f"{k}: {v}" for k, v in out.items()) or "every card is as Project Pals wrote it")
    elif sub == "prune":
        require_owner("pruning the Desk's archive")   # a click, not "hc didn't say pal" (Grok review H1)
        pos, o = opts(args, ("older",))
        m = re.fullmatch(r"(\d+)d", o.get("older") or "")
        if not m:
            die("pal desk prune --older 180d")
        print(f"deleted {crewdesk.prune(int(m.group(1)))} archived cards")
    elif sub == "draft":
        # The idea partner's draft (§13): nothing goes out until the owner clicks Send.
        pos, o = opts(args, ("to", "urgency", "attach", "file"), ("task", "json"))
        rec = record_of(where_of(ME, spaces)[0], records()) if who["me"] else {}
        from crewlib import is_partner
        if not is_partner(rec):
            die(f"only the idea partner writes drafts; send a card with pal desk send (or {OWNER} drops one with Ctrl+Shift+D)")
        text = desk_text(pos, o)
        to, auto = desk_to(spaces, o.get("to") or "auto")
        urgency = o.get("urgency") or "normal"
        if urgency not in ("low", "normal", "soon"):
            die("a draft's urgency is low, normal or soon")
        title, body = crewdesk.split_text(text)
        atts = desk_attachments()
        if crewdesk.conf().get("partner_sends_as_itself"):
            # The owner's setting: the partner's cards go out at once, as a pal's (no owner authority).
            card = crewdesk.create("idea", to, title, body, frm=who["from"], from_kind="pal", proof=who["proof"], urgency=urgency,
                                   via="pal desk draft", attachments=atts, extra={"route": "auto"} if auto else None)
            card, t, what = crewdesk.deliver(card, spaces)
            print(f"{card['id']} → {card['to']}: {what} (sent as you: partner_sends_as_itself is on)")
            return
        card = crewdesk.draft(who["from"], who["proof"], "auto" if auto else to, title, body, urgency, bool(o.get("task")), atts)
        if o.get("json"):
            print(json.dumps(crewdesk.summary(card, crewdesk.need(card["id"])), ensure_ascii=False))
        else:
            print(f"{card['id']} drafted for {card['to']}: it waits for {OWNER}'s Send (the toast, or the Desk view's Drafts). "
                  f"Show {OWNER} the draft in your reply; \"send it\" typed here isn't the click.")
    elif sub == "send-draft" and args:
        if not owner:
            require_owner("send a draft")
        pos, o = opts(args, ("to", "urgency"), ("json",))
        _, card = desk_card(pos[0])
        if card.get("status") != "draft":
            die(f"{card['id']} isn't a draft")
        to, auto = desk_to(spaces, o.get("to") or card.get("to") or "auto")
        task = None
        if card.get("track") == "yes" and to and to != OWNER:
            task = crewtasks.add(card["title"], spaces, None, OWNER, card.get("body") or None, to, notify_assignee=False)["id"]
        card = crewdesk.send_draft(card["id"], to, o.get("urgency"), auto, task)
        card, t, what = crewdesk.deliver(card, spaces) if not auto else (card, None, "sorting it to a pal")
        if o.get("json"):
            print(json.dumps({"card": crewdesk.summary(card, crewdesk.need(card["id"])), "terminal": t, "what": what}, ensure_ascii=False))
        else:
            print(f"{card['id']} → {card['to']}: {what}")
    elif sub == "discard" and args:
        _, card = desk_card(args[0])
        if card.get("status") != "draft":
            die(f"{card['id']} isn't a draft")
        desk_may(card, who, "discard", sender_ok=True)
        print(crewdesk.line(crewdesk.mark(card["id"], "cancelled", by, via, "draft discarded")))
    else:
        die("pal desk ls|open|take|later|done|reply|block|pass|send|sent|cancel|draft|attach|stats|check (see pal --help)")


def desk_attach(src):
    """Copy an image into data/crew-attachments (crewattach.py: images only, 10 MB, no symlinks)."""
    import crewattach
    try:
        out = crewattach.copy(str(src), str(DATA / "crew-attachments"))
    except crewattach.Refused as e:
        die(f"can't attach {src}: {e}")
    return out["path"] if isinstance(out, dict) else str(out)


def cmd_routine(spaces, rest):
    me, name = whoami(spaces)
    sub, args = (rest[0], rest[1:]) if rest else ("ls", [])
    if sub == "add":
        pos, o = opts(args, ("name", "channel"))
        if len(pos) < 3:
            die('pal routine add <Pal> "<when>" "<prompt>" [--name N] [--topic routines]')
        import crewchief
        crewchief.refuse_target(pos[0], "routines (a scheduled prompt is a push)")
        space, _ = find(pos[0], spaces)
        r = crewroutines.add(space["name"], pos[1], " ".join(pos[2:]), o.get("name"), o.get("channel", "routines"), by=name)
        print(f"added {r['id']} {r['name']}: {space['name']} #{r['channel']}, {crewroutines.describe(r['rule'])}"
              + ("" if daemon_alive() else "\n(crewd isn't running, so it won't fire until it is)"))
    elif sub in ("ls", "list"):
        rs = crewroutines.load()
        for r in rs:
            last = r.get("last") or {}
            print(f"{r['id']} {r['name']} · {r['bot']} #{r['channel']} · {crewroutines.describe(r['rule'])}"
                  + (" · paused" if r.get("paused") else "") + (" · running" if r.get("run") else "")
                  + (f" · last {last.get('status')} {ago(last['at'] * 1000)}" + (f" ({last.get('reason') or last.get('summary', '')[:80]})" if last.get("reason") or last.get("summary") else "") if last.get("at") else ""))
            print(f"    {r['prompt'][:160]}")
        if not rs:
            print("(no routines)")
    elif sub == "log":
        _, o = opts(args, ("n",))
        path = DATA / "crew-routines.log.jsonl"
        for l in (path.read_text().splitlines() if path.exists() else [])[-int(o.get("n", 20)):]:
            e = json.loads(l)
            print(f"{time.strftime('%a %H:%M', time.localtime(e['at'] / 1000))} {e['name']} ({e['bot']}): {e['status']}"
                  + (f" · {e.get('reason') or e.get('summary', '')}" if e.get("reason") or e.get("summary") else ""))
    elif sub == "edit" and args:
        _, o = opts(args[1:], ("name", "when", "prompt", "channel"))
        r = crewroutines.edit(args[0], o.get("name"), o.get("when"), o.get("prompt"), o.get("channel"))
        print(f"updated {r['id']} {r['name']}: {r['bot']} #{r['channel']}, {crewroutines.describe(r['rule'])}")
    elif sub in ("run", "pause", "resume", "rm") and args:
        with locked("routines"):
            rs = crewroutines.load()
            r = next((x for x in rs if x["id"] == args[0] or x["name"].lower() == " ".join(args).lower()), None)
            if not r:
                die(f"no routine {args[0]}")
            if sub == "rm":
                rs.remove(r)
            elif sub == "run":
                r["force"] = True
            else:
                r["paused"] = sub == "pause"
                r["next"] = crewroutines.next_run(r)
            crewroutines.save(rs)
        print({"rm": "removed", "run": "running it now", "pause": "paused", "resume": "resumed"}[sub] + f": {r['name']}")
    else:
        die("pal routine add|ls|log|run|pause|resume|rm (see crew --help)")


def my_bot(spaces):
    s, t = where_of(ME, spaces) if ME else (None, None)
    return s, t


def cmd_remember(spaces, args):
    pos, o = opts(args, ("bot",), ("user",))
    if not pos:
        die('pal remember "<fact>" [--user]')
    s, t = my_bot(spaces)
    bot = o.get("bot") or (s["name"] if s else None)
    if not bot and not o.get("user"):
        die("run this from a pal's topic, or say which: --pal Name")
    path = remember(bot or f"{OWNER}", " ".join(pos), channel=chan(t) if t else None, user=o.get("user", False))
    print(f"remembered ({path.relative_to(DATA)})")


def cmd_memory(spaces, args):
    args, o = opts(args, (), ("json",))
    if o.get("json"):
        # For the profile panel: what a session starts with (and what's left out), MEMORY.md, the
        # last 3 days of notes newest first, and how many facts about the owner every pal shares.
        if not args:
            die("pal memory <Pal> --json")
        space, _ = find(args[0], spaces)
        bot, pinned = space["name"], record_of(space).get("memory", "")
        rep = memory_report(bot, pinned)
        d = memory_dir(bot)
        notes = []
        for n in (sorted((d / "notes").glob("*.md"))[-3:] if (d / "notes").exists() else [])[::-1]:
            lines = [l[2:] for l in n.read_text().splitlines() if l.startswith("- ")]
            notes.append({"day": n.stem, "lines": lines[::-1]})
        user = MEMORY / "USER.md"
        print(json.dumps({"bot": bot, "pinned": pinned, **rep,
                          "memory_md": (d / "MEMORY.md").read_text() if (d / "MEMORY.md").exists() else "",
                          "notes": notes, "folder": str(d),
                          "user_facts": sum(1 for l in (user.read_text().splitlines() if user.exists() else []) if l.startswith("- "))}))
        return
    if args:
        space, _ = find(args[0], spaces)
        bot = space["name"]
    else:
        s, _ = my_bot(spaces)
        if not s:
            print((MEMORY / "USER.md").read_text() if (MEMORY / "USER.md").exists() else f"(nothing about {OWNER} yet)")
            return
        space, bot = s, s["name"]
    # Everything (the primer gets the first MEMORY_CAP characters of this, in the same order).
    print(memory_text(bot, record_of(space).get("memory", ""), days=30, limit=10**7) or f"(nothing remembered for {bot} yet)")


# ─── Mission, brain, agent files, proposals (docs/profiles/proposal.md) ─────────────────────────

ARGV = []   # this run's arguments, as the owner's click token must match them (owner_gate)


def owner_args():
    """ARGV without the --click token itself."""
    out, skip = [], False
    for a in ARGV:
        if skip:
            skip = False
            continue
        if a == "--click":
            skip = True
            continue
        out.append(a)
    return out


def click_of():
    return ARGV[ARGV.index("--click") + 1] if "--click" in ARGV and ARGV.index("--click") + 1 < len(ARGV) else None


def require_owner(what):
    """An owner decision: only the app's one-time click token for exactly this command line. Anything
    else (a pal, a missing or unknown terminal ID, a terminal typing "yes") is refused (review H1)."""
    return owner_gate(owner_args(), click_of(), what)


def pal_of(spaces, spec=None):
    """(space, record, name) for `spec`, else the pal running this."""
    if spec:
        space, _ = find(spec, spaces)
    else:
        space, _ = my_bot(spaces)
        if not space:
            die("run this from a pal's topic, or say which: --pal Name")
    return space, record_of(space), space["name"]


def folder_of(space, record):
    f = record.get("folder") or space.get("folder")
    if not f:
        die(f"{space['name']} has no project folder")
    return os.path.expanduser(f)


def file_opt(o):
    path = o.get("file")
    if not path:
        die("give the text with --file F (or -F F)")
    return sys.stdin.read() if path == "-" else open(os.path.expanduser(path)).read()


def brain_log(space, record, name, text, channel=None, by=None):
    import crewbrain
    try:
        return crewbrain.log(crewbrain.brain_dir(name, {**record, "folder": record.get("folder") or space.get("folder")}), text, channel, by)
    except OSError:
        return None


def cmd_mission(spaces, rest):
    import crewbrain
    sub = rest[0] if rest and rest[0] in ("focus", "tick", "set", "propose", "show") else "show"
    args = rest[1:] if rest and rest[0] == sub else rest
    pos, o = opts(args, ("pal", "file", "expect", "note"), ("json", "undo"))
    _, t = my_bot(spaces)
    if sub == "show":
        space, rec, name = pal_of(spaces, pos[0] if pos else o.get("pal"))
        d = crewbrain.brain_dir(name, {**rec, "folder": folder_of(space, rec) if (rec.get("folder") or space.get("folder")) else None})
        text = crewbrain.read(d, "mission.md")
        if o.get("json"):
            print(json.dumps({"pal": name, "dir": str(d), "text": text, "sha": crewbrain.sha(text), **crewbrain.parse_mission(text)}))
        else:
            print(text or f"(no mission yet for {name}: {OWNER} writes it in the profile panel, or a pal proposes one with pal mission propose --file F)")
        return
    space, rec, name = pal_of(spaces, o.get("pal") or (pos[0] if sub == "set" and pos else None))
    rec = {**rec, "folder": rec.get("folder") or space.get("folder")}
    d = crewbrain.brain_dir(name, rec)
    if sub == "focus":
        if not pos:
            die('pal mission focus "what you\'re on now"')
        crewbrain.set_focus(d, " ".join(pos))
        brain_log(space, rec, name, f"focus: {' '.join(pos)}", chan(t) if t else None)
        print(f"{name}'s focus: {' '.join(pos)}")
    elif sub == "tick":
        if not pos:
            die('pal mission tick "goal or done-when text" [--undo]')
        item = crewbrain.tick(d, " ".join(pos), done=False if o.get("undo") else None)
        brain_log(space, rec, name, f"{'done' if item['done'] else 'reopened'}: {item['text']}", chan(t) if t else None)
        print(f"{'[x]' if item['done'] else '[ ]'} {item['text']}")
    elif sub == "set":
        require_owner("Rewrite the mission")
        text = file_opt(o)
        cur = crewbrain.read(d, "mission.md")
        if o.get("expect") and crewbrain.sha(cur) != o["expect"]:
            die("the mission changed since you opened it; look again")
        crewbrain.write(d, "mission.md", text)
        brain_log(space, rec, name, "mission updated", by=OWNER)
        print(f"wrote {d / 'mission.md'}")
    elif sub == "propose":
        import crewproposals
        text = file_opt(o)
        cur = crewbrain.read(d, "mission.md")
        p = crewproposals.propose("mission", name, f"{name}#{chan(t)}" if t else OWNER, text, "mission.md", crewbrain.sha(cur), o.get("note"))
        print(f"proposed ({p['id']}): {OWNER} sees it in the Inbox and accepts or declines it; you'll hear which")


def cmd_brain(spaces, rest):
    import crewbrain
    sub = rest[0] if rest else "ls"
    args = rest[1:]
    pos, o = opts(args, ("pal", "why", "by", "file", "expect"), ("json",))
    _, t = my_bot(spaces)
    ch = chan(t) if t else None
    spec, fname = o.get("pal"), None
    looks_file = lambda x: x.endswith(".md") or x.startswith("notes/") or x in ("mission", "decisions", "changelog", "map")
    if sub == "show" and len(pos) >= 2:
        spec, fname = spec or pos[0], pos[1]
    elif sub == "show" and pos:
        if looks_file(pos[0]):
            fname = pos[0]
        else:
            spec = spec or pos[0]
    elif sub in ("ls", "where", "write") and pos:
        spec = spec or pos[0]
    space, rec, name = pal_of(spaces, spec)
    rec = {**rec, "folder": rec.get("folder") or space.get("folder")}
    d = crewbrain.brain_dir(name, rec)
    if sub == "ls":
        import crewagents
        agents = crewagents.read(os.path.join(rec["folder"], "AGENTS.md")) if rec.get("folder") else None
        has_map = bool(agents and re.search(r"^#+\s*(Layout|File map|Files|Map|Structure)\b", agents, re.M | re.I))
        info = crewbrain.summary(name, rec, has_map)
        # An init-project-brain brain in the project, adopted in place (edits go through the
        # agent-files writer, with the owner's click).
        pb = os.path.join(rec["folder"], "_Brain", "PROJECT_BRAIN.md") if rec.get("folder") else None
        info["project_brain"] = "_Brain/PROJECT_BRAIN.md" if pb and os.path.exists(pb) else None
        if o.get("json"):
            print(json.dumps(info))
            return
        m = info["mission"]
        print(f"{name}'s brain ({info['where']}): {info['dir']}")
        print(f"  mission: {m['statement'] or '(none yet)'}" + (f"\n  focus: {m['focus']}" if m["focus"] else ""))
        print(f"  decisions: {len(info['decisions'])} · change log: {len(info['changelog'])} · notes: {len(info['notes'])}"
              + (" · map: AGENTS.md has one" if has_map else ""))
    elif sub == "show":
        f = fname or "mission.md"
        f = f if f.endswith(".md") else f + ".md"
        text = crewbrain.read(d, f)
        if o.get("json"):
            print(json.dumps({"file": f, "text": text, "sha": crewbrain.sha(text), "dir": str(d)}))
        else:
            print(text or f"(no {f} in {d})")
    elif sub == "log":
        if not pos:
            die('pal brain log "what changed"')
        print(crewbrain.log(d, " ".join(pos), ch, o.get("by")))
    elif sub == "decide":
        if not pos:
            die('pal brain decide "what" --why "why" [--by Who]')
        print(crewbrain.decide(d, " ".join(pos), o.get("why"), o.get("by") or (name if t else OWNER)))
    elif sub == "note":
        if len(pos) < 2:
            die('pal brain note <subject> "text"')
        print("added to " + crewbrain.note(d, pos[0], " ".join(pos[1:])))
    elif sub == "where":
        require_owner("Move a brain")
        to = pos[1] if len(pos) > 1 else None
        if to not in ("pal", "project"):
            die("pal brain where <Pal> pal|project")
        src, dst, copied = crewbrain.move(name, rec, to)
        set_record(spaces, space, brainIn=to)
        print(f"{name}'s brain is now in {dst}" + (f" (copied {len(copied)} file(s) from {src}; nothing deleted)" if copied else ""))
    elif sub == "write":
        require_owner("Rewrite a brain file")
        f = pos[1] if len(pos) > 1 else None
        if not f or "/" in f.replace("notes/", "", 1) or not f.endswith(".md"):
            die("pal brain write <Pal> <file.md> --file F --expect SHA")
        text = file_opt(o)
        cur = crewbrain.read(d, f)
        if crewbrain.sha(cur) != (o.get("expect") or "none"):
            die(f"{f} changed since you opened it; look again")
        crewbrain.write(d, f, text)
        print(f"wrote {d / f}")
    else:
        die("pal brain ls | show [Pal] [file] | log \"…\" | decide \"…\" --why \"…\" | note <subject> \"…\" | where <Pal> pal|project")


def set_record(spaces, space, **fields):
    """Change a pal's record (shared.json's crew.bots) the way the app does: through a request, so
    the roster writes it (only the app writes shared.json)."""
    request("record", spaces, space=space["id"], fields=fields)


def cmd_agents(spaces, rest):
    import crewagents, crewbrain
    sub = rest[0] if rest else "show"
    args = rest[1:]
    pos, o = opts(args, ("pal", "from", "expect", "note", "file", "proposal", "folder", "staged-sha"), ("json", "deep"))
    if sub in ("show", "lint"):
        space, rec, name = pal_of(spaces, pos[0] if pos else o.get("pal"))
        folder = folder_of(space, rec)
        out = crewagents.lint(folder)
        if o.get("deep"):
            out["deep"] = crewagents.deep(folder, crewbrain.brain_dir(name, {**rec, "folder": folder}))
        if sub == "show":
            out["texts"] = {f["file"]: crewagents.read(os.path.join(folder, f["file"])) for f in out["files"] if f["exists"]}
        if o.get("json"):
            print(json.dumps(out))
            return
        print(f"{name}: {folder}")
        print("  Claude Code loads: " + " + ".join(f"{p['file']} {p['lines']}" for p in out["loads"]["parts"]) + f" = {out['loads']['total']} lines")
        for f in out["files"]:
            if f["exists"]:
                print(f"  {f['file']}: {f['lines']} lines")
        for l in out["lint"] or [{"level": "ok", "id": "-", "file": "", "msg": f"nothing to fix ({out['paths_checked']} paths checked)"}]:
            print(f"  [{l['level']}] {l['id']} {l['file']}: {l['msg']}")
        for x in out.get("deep", []):
            print(f"  [deep] {x.get('why', '')}: \"{x.get('quote_a', '')}\" vs \"{x.get('quote_b', '')}\"")
    elif sub == "apply":
        require_owner("Write a project's AGENTS.md / CLAUDE.md")
        if len(pos) < 2 or not o.get("from") or not o.get("expect"):
            die("pal agents apply <Pal> <file> --from STAGED --expect SHA [--note N] [--proposal ID]")
        space, rec, name = pal_of(spaces, pos[0])
        folder = folder_of(space, rec)
        # Bound to the folder and the exact staged text the owner reviewed (review H4).
        if o.get("folder") and os.path.realpath(os.path.expanduser(o["folder"])) != os.path.realpath(folder):
            die(f"that review was for {o['folder']}, but {name}'s folder is {folder}; review it again")
        text = open(os.path.expanduser(o["from"])).read()
        if o.get("staged-sha") and crewagents.sha(text) != o["staged-sha"]:
            die("the staged text changed after the review; review it again")
        out = crewagents.apply(name, folder, pos[1], text, o["expect"], o.get("note"))
        brain_log(space, rec, name, f"{out['file']}: {o.get('note') or ('created' if out['created'] else 'edited')} ({OWNER})")
        if o.get("proposal"):
            import crewproposals
            crewproposals.decide(o["proposal"], "accepted", via="profile panel")
            tell_proposer(spaces, o["proposal"], True)
            pattern = (crewproposals.get(o["proposal"]).get("meta") or {}).get("pattern")
            if pattern:
                import crewdream
                crewdream.decided(pattern, True, o["proposal"])
        print(json.dumps(out) if o.get("json") else f"wrote {out['path']} (backup: {out['backup']}). Not committed.")
    elif sub == "propose":
        import crewproposals
        if not pos:
            die("pal agents propose <file> --file F [--note \"why\"] [--pal P]")
        space, rec, name = pal_of(spaces, o.get("pal"))
        folder = folder_of(space, rec)
        rel = pos[0][2:] if pos[0].startswith("./") else pos[0]
        if not crewagents.WRITABLE.match(rel) or ".." in rel.split("/"):
            die(f"{rel}: only AGENTS.md, CLAUDE.md, .claude/CLAUDE.md, CLAUDE.local.md, _Brain/PROJECT_BRAIN.md or .pals/*.md")
        _, t = my_bot(spaces)
        cur = crewagents.read(os.path.join(folder, rel))
        p = crewproposals.propose("agents", name, f"{name}#{chan(t)}" if t else OWNER, file_opt(o), rel, crewagents.sha(cur), o.get("note"))
        print(f"proposed ({p['id']}): {OWNER} sees the diff in the Inbox and applies or declines it; you'll hear which")
    elif sub == "backups":
        space, rec, name = pal_of(spaces, pos[0] if pos else o.get("pal"))
        bs = crewagents.backups(name, pos[1] if len(pos) > 1 else None)
        print(json.dumps(bs) if o.get("json") else "\n".join(f"{b['at']} {b['file']}{' (did not exist)' if b['absent'] else ''}" for b in bs) or "(no backups)")
    else:
        die("pal agents show|lint [Pal] [--json] [--deep] | propose <file> --file F | apply (the owner) | backups [Pal] [file]")


def tell_proposer(spaces, pid, accepted, why=None):
    import crewproposals
    p = crewproposals.get(pid)
    by = p.get("by") or ""
    if "#" not in by:
        return
    what = ("your mission proposal" if p["kind"] == "mission" else f"your dream proposal for {(p.get('meta') or {}).get('pattern')}"
            if p["kind"] == "dream" else f"your {p.get('file') or 'file'} proposal")
    try:
        target = find(by, spaces)[1]
        lt = lead(target)
        if lt:
            enqueue(lt["terminal"], f"{OWNER} {'accepted' if accepted else 'declined'} {what} ({pid})." + (f" Why: {why}" if why else ""), sender=OWNER)
    except CrewError:
        pass


def cmd_proposals(spaces, rest):
    import crewproposals, crewbrain
    sub = rest[0] if rest else "ls"
    pos, o = opts(rest[1:], ("note", "text-sha"), ("json",))
    if sub == "ls":
        ps = crewproposals.all_("pending")
        print(json.dumps(ps) if o.get("json") else "\n".join(f"{p['id']} {p['kind']} {p['pal']}: {p.get('file') or ''} from {p['by']}" for p in ps) or "(no proposals waiting)")
    elif sub == "show" and pos:
        p = crewproposals.get(pos[0])
        print(json.dumps({**p, "text_sha": crewproposals.text_sha(p)}))
    elif sub in ("accept", "decline") and pos:
        require_owner("Decide a proposal")
        p = crewproposals.get(pos[0])
        if p["status"] != "pending":
            die(f"{p['id']} is already {p['status']}")
        pattern = (p.get("meta") or {}).get("pattern")
        if sub == "decline":
            why = " ".join(pos[1:]) or o.get("note")
            crewproposals.decide(p["id"], "declined", why, via="cli")
            tell_proposer(spaces, p["id"], False, why)
            if pattern:
                import crewdream
                crewdream.decided(pattern, False, p["id"], why)
            print(f"declined {p['id']}")
            return
        if p["kind"] == "dream":
            crewproposals.check_reviewed(p, o.get("text-sha"))   # review H5: the text the owner saw
            print(apply_dream(spaces, p))
            crewproposals.decide(p["id"], "accepted", via="cli")
            import crewdream
            crewdream.decided(pattern, True, p["id"])
            tell_proposer(spaces, p["id"], True)
            print(f"accepted {p['id']}; {pattern} is watched for {crewdream.WATCH_DAYS} days")
            return
        space, rec, name = pal_of(spaces, p["pal"])
        rec = {**rec, "folder": rec.get("folder") or space.get("folder")}
        if p["kind"] == "mission":
            crewproposals.check_reviewed(p, o.get("text-sha"))
            d = crewbrain.brain_dir(name, rec)
            if crewbrain.sha(crewbrain.read(d, "mission.md")) != p.get("base"):
                die("the mission changed since this was proposed; open it in the profile panel and compare")
            crewbrain.write(d, "mission.md", p["text"])
            brain_log(space, rec, name, f"mission updated from {p['by']}'s proposal", by=OWNER)
        elif p["kind"] == "agents":
            import crewagents
            out = crewagents.apply(name, folder_of(space, rec), p["file"], p["text"], p.get("base") or "none", p.get("note"))
            brain_log(space, rec, name, f"{out['file']}: {p.get('note') or 'edited'} (from {p['by']}'s proposal, {OWNER})")
        else:
            die(f"accept {p['kind']} proposals in the Inbox")
        crewproposals.decide(p["id"], "accepted", via="cli")
        tell_proposer(spaces, p["id"], True)
        if pattern:
            import crewdream
            crewdream.decided(pattern, True, p["id"])
        print(f"accepted {p['id']}")
    else:
        die("pal proposals [ls] [--json] | pal proposal show|accept|decline ID [\"why\"]")


def cmd_notebook(spaces, rest):
    """pal notebook ["did: …"] [--hiccup "…"]… [--needed "kind: …"]… [--lesson "…"] [--task T] [--took 40m]
       pal notebook hiccup "…" [--needed …]   ·   pal notebook [ls] [Pal] [--days 7] [--json]   ·   pal notebook rm <Pal> <day> <HH:MM> (the owner)"""
    import crewnotebook
    sub = rest[0] if rest and rest[0] in ("hiccup", "ls", "rm", "show") else None
    args = rest[1:] if sub else rest
    multi = {"hiccup": [], "needed": []}
    single = {}
    pos = []
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--hiccup", "--needed") and i + 1 < len(args):
            multi[a[2:]].append(args[i + 1]); i += 2
        elif a in ("--lesson", "--task", "--took", "--pal", "--days", "--did") and i + 1 < len(args):
            single[a[2:]] = args[i + 1]; i += 2
        elif a == "--json":
            single["json"] = True; i += 1
        elif a.startswith("--"):
            die(f"unknown option {a}. See pal notebook --help")
        else:
            pos.append(a); i += 1
    me_space, t = my_bot(spaces)
    if sub in ("ls", "show") or (sub is None and not pos and not any(multi.values()) and not single.get("lesson") and not single.get("did")):
        space, rec, name = pal_of(spaces, (pos[0] if pos else None) or single.get("pal"))
        ds = crewnotebook.days(name, int(single.get("days") or (7 if sub == "ls" else 1)))
        if single.get("json"):
            print(json.dumps({"pal": name, "days": ds, "week": crewnotebook.week(name)}))
            return
        if not ds:
            print(f"(nothing in {name}'s notebook yet)")
        for day in ds:
            print(crewnotebook.day_path(name, day["day"]).read_text().rstrip() + "\n")
        return
    if sub == "rm":
        require_owner("Remove a notebook entry")
        if len(pos) < 3:
            die("pal notebook rm <Pal> <YYYY-MM-DD> <entry id | \"HH:MM #topic\">")
        space, rec, name = pal_of(spaces, pos[0])
        crewnotebook.remove(name, pos[1], " ".join(pos[2:]), DATA / "crew-backups" / "notebook" / slug(name))
        print(f"removed entry {' '.join(pos[2:])} from {name}'s {pos[1]} (a copy of the day is in crew-backups/notebook/)")
        return
    space, rec, name = pal_of(spaces, single.get("pal"))
    text = " ".join(pos)
    did = single.get("did")
    if sub == "hiccup":
        multi["hiccup"].insert(0, text)
    elif text:
        key, _, val = text.partition(":")
        if key.strip().lower() in ("did", "hiccup", "needed", "lesson") and val.strip():
            {"did": lambda: None, "hiccup": lambda: multi["hiccup"].insert(0, val.strip()),
             "needed": lambda: multi["needed"].insert(0, val.strip()), "lesson": lambda: single.setdefault("lesson", val.strip())}[key.strip().lower()]()
            did = val.strip() if key.strip().lower() == "did" else did
        else:
            did = text
    out = crewnotebook.add(name, did, multi["hiccup"], multi["needed"], single.get("lesson"),
                           chan(t) if t else None, single.get("task"), single.get("took"), rec.get("folder") or space.get("folder"))
    print(("added to" if out["merged"] else "wrote") + f" {name}'s notebook: " + " · ".join(l[2:] for l in out["lines"]))


def cmd_dream(spaces, rest):
    import crewdream, crewproposals
    sub = rest[0] if rest and rest[0] in ("ls", "propose", "intake", "run") else "run"
    args = rest[1:] if rest and rest[0] == sub else rest
    pos, o = opts(args, ("pattern", "kind", "name", "pal", "file", "note"), ("json", "dry-run", "no-model", "force"))
    if sub == "run":
        out = crewdream.dream(force=o.get("force"), model=not o.get("no-model"), dry=o.get("dry-run"))
        if o.get("json"):
            print(json.dumps(out))
            return
        if out.get("skipped"):
            print(f"nothing to dream about: {out['new']} new hiccup(s) since the last dream (needs {crewdream.MIN_NEW}; --force to run anyway)")
            return
        print(f"grouped {out['lines']} notebook line(s) ({out['grouped_by']}); {len(out['qualifying'])} pattern(s) qualify")
        for p in out.get("all") or out["qualifying"]:
            print(f"  {p['id']} [{p['status']}] {p['summary']} · {p['count']}x, {len(p['pals'])} pal(s), ~{p['minutes']}m")
        if out.get("digest"):
            term = head_terminal(spaces)
            if term:
                enqueue(term, out["digest"], sender="dream", kind="dream")
                print("sent the digest to the head pal, which drafts the proposals")
            else:
                print(out["digest"])
    elif sub == "ls":
        st = crewdream.stats()
        if o.get("json"):
            print(json.dumps(st))
            return
        print(f"this month: {st['proposed']} proposed · {st['accepted']} accepted · {st['declined']} declined · "
              f"{st['resolved']} resolved · {st['recurred']} recurred · ~{st['minutes_week']}m of hiccups this week")
        for p in st["patterns"] or [{"id": "-", "status": "", "summary": "(no patterns yet)", "count": 0, "pals": [], "minutes": 0}]:
            print(f"  {p['id']} [{p['status']}] {p['summary']} · {p['count']}x, {len(p['pals'])} pal(s), ~{p['minutes']}m")
    elif sub == "propose":
        kind, pid = o.get("kind"), o.get("pattern")
        if kind not in crewdream.KINDS or not pid:
            die("pal dream propose --pattern P-n --kind skill|rule|tool|process|context [--name N] [--pal P] -F text.md --note \"why\"")
        p = crewdream.patterns().get(pid)
        if not p:
            die(f"no pattern {pid} (pal dream ls)")
        recent = [x for x in crewproposals.all_("pending") if (x.get("meta") or {}).get("pattern") and now_ms() - x["at"] < 86400 * 1000]
        if len(recent) >= crewdream.MAX_PROPOSALS:
            die(f"{len(recent)} dream proposals are already waiting from the last day (at most {crewdream.MAX_PROPOSALS})")
        text = file_opt(o)
        _, t = my_bot(spaces)
        by = f"{whoami(spaces)[1] or OWNER}" + (f"#{chan(t)}" if t else "")
        meta = {"pattern": pid, "kind": kind, "summary": p["summary"], "count": p["count"], "pals": p["pals"], "minutes": p["minutes"],
                "quotes": [x["text"] for x in p.get("sources", [])[-2:]]}
        if kind == "rule":
            import crewagents
            space, rec, name = pal_of(spaces, o.get("pal") or die("a rule goes in a pal's project: --pal \"Pal\""))
            folder = folder_of(space, rec)
            cur = crewagents.read(os.path.join(folder, "AGENTS.md"))
            new = (cur.rstrip() + "\n\n" if cur else "") + text.strip() + "\n"
            pr = crewproposals.propose("agents", name, by, new, "AGENTS.md", crewagents.sha(cur), o.get("note"), meta)
        elif kind == "skill":
            if not o.get("name"):
                die("a skill needs --name skill-name")
            meta["name"] = slug(o["name"])
            pr = crewproposals.propose("dream", "crew", by, text, f"skill {meta['name']}", None, o.get("note"), meta)
        else:
            target = o.get("pal")
            if target:
                space, _, target = pal_of(spaces, target)
            meta["pal"] = target
            meta["topic"] = o.get("name") or p["summary"][:40]
            pr = crewproposals.propose("dream", target or "crew", by, text, None, None, o.get("note"), meta)
        crewdream.proposed(pid, pr["id"])
        print(f"proposed ({pr['id']}) for {pid}: {OWNER} sees it in the Inbox; nothing is written before {OWNER} approves it")
    elif sub == "intake":
        if not o.get("pattern"):
            die("pal dream intake --pattern P-n -F note.md   (a draft for DJM OS's intake; the owner files it)")
        path = crewdream.intake(o["pattern"], file_opt(o))
        print(f"drafted {path} for {OWNER} to file (Project Pals never writes DJM OS)")


def apply_dream(spaces, p):
    """An accepted dream proposal (not a rule: those are agents proposals), through its kind's writer."""
    m = p.get("meta") or {}
    kind = m.get("kind")
    if kind == "skill":
        import crewskills
        f = crewskills.save(m["name"], (p.get("note") or m.get("summary") or "")[:200], p["text"], by="dream")
        linked = crewskills.link(f.parent.name)
        return f"saved skill {f.parent.name}" + (f"; linked for {', '.join(linked)}" if linked else "")
    if kind in ("tool", "process"):
        title = next((l.strip("# ").strip() for l in p["text"].splitlines() if l.strip()), m.get("summary", "dream task"))[:120]
        target = m.get("pal") or (settings().get("head") if kind == "process" else None)
        t = crewtasks.add(title, spaces, None, OWNER, p["text"], target)
        return f"added {t['id']} for {target or 'anyone'}"
    if kind == "context":
        import crewbrain
        if not m.get("pal"):
            die("a context proposal needs a pal")
        space, rec, name = pal_of(spaces, m["pal"])
        rec = {**rec, "folder": rec.get("folder") or space.get("folder")}
        f = crewbrain.note(crewbrain.brain_dir(name, rec), m.get("topic") or "dream", p["text"])
        return f"added to {name}'s brain: {f}"
    die(f"can't apply a {kind} proposal here")


def cmd_skill(spaces, rest):
    sub, args = (rest[0], rest[1:]) if rest else ("ls", [])
    if sub in ("ls", "list"):
        for s in crewskills.all_skills():
            print(f"{s['name']}{' (learned)' if s['learned'] else ''}: {s['description']}")
        if not crewskills.all_skills():
            print("(no shared skills yet)")
    elif sub == "show" and args:
        f = crewskills.get(args[0])
        if not f:
            die(f"no skill {args[0]}")
        print(f.read_text())
    elif sub == "save" and args:
        pos, o = opts(args, ("description", "file"))
        body = Path(o["file"]).read_text() if o.get("file") else sys.stdin.read()
        if not body.strip():
            die("the skill's steps go on stdin or in --file")
        try:
            _, name = whoami(spaces or herdr_spaces())
        except CrewError:
            name = None
        f = crewskills.save(pos[0], o.get("description", ""), body, by=name)
        print(f"saved {f.parent.name}; linked for: " + (", ".join(crewskills.link(f.parent.name)) or "nothing (a skill of that name already exists there)"))
    elif sub == "archive" and args:
        d = crewskills.archive(args[0])
        print(f"archived to {d}" if d else f"no skill {args[0]}")
    else:
        die("pal skill ls|show|save|archive (see crew --help)")


def cmd_approvals(decide=None, rid=None, note=None, inbox=False):
    if decide:
        # Only the owner decides, with the Inbox's click (review H1).
        require_owner(f"{decide.capitalize()} a held command")
        via = "the Inbox"
        r = crewguard.decide(rid, decide == "approve", note, via=via)
        print(f"{r['status']}: {r['bot']} #{r['channel']}: {r['command']}")
        return
    pend = [a for a in crewguard.all_requests() if a["status"] == "pending"]
    for a in pend:
        print(f"{a['id']} · {a['bot']} #{a['channel']} · {a['why'] or a['rule']} · {ago(a['at'])}\n    {a['command']}")
    if not pend:
        print("(nothing waiting)")


def cmd_settings(rest):
    """pal settings | pal settings owner "Sam" | pal settings head "Orchestrator" | pal settings bypass on|off | pal settings llm auto|claude|agy"""
    from crewlib import save_settings
    if rest and rest[0] == "desk":
        c = crewdesk.conf()
        for k, (vals, what) in crewdesk.SETTING_HELP.items():
            v = c.get(k)
            print(f"desk.{k} = {('on' if v else 'off') if isinstance(v, bool) else v}    ({vals}: {what})")
        return
    if not rest:
        st = settings()
        print(f"owner: {st['owner']}\nhead pal: {st['head']}\nhead pal's inbox topic: {'#' + head_topic() if head_topic() else 'none (the topic it shows, else its first tab)'}"
              f"\nbypass permissions for new pals: {'on' if st['bypass'] else 'off'}\nbackground llm: {st.get('llm', 'auto')}")
        return
    # Changing one is the owner's: a click in Project Pals (About, Settings → Desk). A missing or
    # unknown terminal ID isn't the owner (Grok review H1).
    require_owner("changing settings")
    key, val = rest[0], " ".join(rest[1:]).strip()
    if key.startswith("desk."):
        # The Desk's settings apply at once (crewd reads them each time), so no restart.
        v = crewdesk.set_setting(key[5:], val)
        print(f"{key} = {('on' if v else 'off') if isinstance(v, bool) else v}")
        return
    if key == "owner" and val:
        st = save_settings(owner=val)
    elif key == "bypass" and val in ("on", "off"):
        st = save_settings(bypass=val == "on")
    elif key == "llm" and val in ("auto", "claude", "agy"):
        st = save_settings(llm=val)
    elif key in ("head-topic", "head_topic"):
        # T60: where everything pushed to the head pal goes ("" or "none": as before, the topic it shows, else its first tab).
        topic = "" if val.lower() in ("", "none", "off") else val.lstrip("#").strip()
        if topic and not re.fullmatch(r"[\w.-]{1,64}", topic):
            die("a topic name: letters, digits, - _ . (e.g. ops)")
        st = save_settings(head_topic=topic)
        if not topic:
            s = load_json(SETTINGS, {})
            s.pop("head_topic", None)
            save_json(SETTINGS, s)
        try:
            head = next((sp for sp in herdr_spaces() if record_of(sp, records()).get("god")), None)
        except CrewError:
            head = None
        if topic and head and not head_inbox(head):
            print(f"note: {head['name']} has no #{topic} yet; pushes go to the topic it shows (else its first tab) until it does")
        print(f"head pal's inbox topic: {'#' + topic if topic else 'none (the topic it shows, else its first tab)'}")
        return
    elif key == "head" and val:
        if "#" in val or val.startswith("@"):
            die("a pal's name can't have # in it or start with @")
        # The layout renames its space (if one's hired); its memory and routines follow the name.
        # Check the memory folder first, so a clash stops everything before anything is renamed.
        prev = settings()["head"]
        src, dest = memory_dir(prev), memory_dir(val)
        if src.exists() and dest.exists() and src != dest:
            die(f"there's already a memory folder for {val} ({dest}); move it aside first")
        out = request("rename-head", herdr_spaces(), name=val)
        # A retry after a half-done rename finds the space already renamed: the name in settings
        # is still the old one, so its memory and routines move from there.
        old = out.get("old")
        renamed(old if old and old != val else prev, val)
        st = save_settings(head=val)
    else:
        die('pal settings owner "Name" | pal settings head "Name" | pal settings head-topic ops|none | pal settings bypass on|off | pal settings llm auto|claude|agy | pal settings desk.<key> <value> (pal settings desk lists them)')
    # crewd reads the owner's name when it starts.
    subprocess.run(["systemctl", "--user", "try-restart", "herdr-crew.service"], capture_output=True)
    print(f"owner: {st['owner']} · head pal: {st['head']} · bypass: {'on' if st['bypass'] else 'off'} · llm: {st.get('llm', 'auto')}")


UPDATE_LOG = DATA / "crew-update.log"


def update_log(msg):
    """Every install or rollback attempt, step by step, so one that fails (say from About) leaves a
    trace: data/crew-update.log, the last 400 lines."""
    try:
        lines = UPDATE_LOG.read_text().splitlines()[-399:] if UPDATE_LOG.exists() else []
        lines.append(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}")
        UPDATE_LOG.write_text("\n".join(lines) + "\n")
    except OSError:
        pass


def cmd_update(rest):
    sub = next((a for a in rest if not a.startswith("--")), "check")
    as_json = "--json" in rest
    who = f"terminal {ME}" if ME else ("the app, e.g. About (--json, no terminal)" if as_json else "a terminal outside Herdr")
    if sub in ("apply", "rollback"):
        update_log(f"{sub} started by {who}, installed {crewupdate.installed().get('version', '?')}")
    # Installing or rolling back code is the owner's call: a click in Project Pals (About, Update now),
    # never a pal's, and not anyone hc doesn't call a pal (Grok review H1).
    if sub in ("apply", "rollback"):
        if not click_of():
            update_log(f"{sub} refused: no click from Project Pals")
        require_owner(f"updates are {OWNER}'s to install (About → Update)")
    if sub in ("apply", "rollback"):
        crewupdate.run_state(fresh=True, action=sub, state="running", step="starting", started=time.time(), pid=os.getpid(),
                             **{"from": crewupdate.installed().get("version")})
    try:
        if sub == "check":
            out = crewupdate.check()
            update_log(f"check by {who}: GitHub's newest is {out.get('latest') or 'none'} (installed {out.get('current')})")
        elif sub == "apply":
            say = (lambda *_: None) if as_json else print
            out = crewupdate.apply(log=lambda m: (update_log(m), say(m), crewupdate.run_state(state="running", step=m)))
        elif sub == "rollback":
            say = (lambda *_: None) if as_json else print
            out = {"ok": True, "restored": str(crewupdate.rollback(log=lambda m: (update_log(m), say(m))))}
        else:
            die("pal update check | apply | rollback [--json]")
    except CrewError as e:
        if sub == "check":
            update_log(f"check by {who} failed: {e}")
        if sub in ("apply", "rollback"):
            update_log(f"{sub} failed: {e}")
            crewupdate.run_state(state="failed", error=str(e))
        if as_json:
            print(json.dumps({"ok": False, "error": str(e)}))
            sys.exit(1)
        raise
    except Exception as e:
        if sub in ("apply", "rollback"):
            update_log(f"{sub} crashed: {type(e).__name__}: {e}")
            crewupdate.run_state(state="failed", error=f"{type(e).__name__}: {e}")
        raise
    if sub in ("apply", "rollback"):
        update_log(f"{sub} done: {json.dumps(out)}")
        crewupdate.run_state(state="done", step=None, version=out.get("version") or crewupdate.installed().get("version"),
                             updated=out.get("updated", sub == "rollback"), backup=out.get("backup"))
    if as_json:
        print(json.dumps(out))
    elif sub == "check":
        if not out.get("latest"):
            print(f"{out.get('repo')} has no releases yet (installed: {out.get('current')})")
        elif out["available"]:
            print(f"{out['latest']} is out (installed: {out['current']}). Update with: pal update apply\n\n{out.get('notes', '')}")
        else:
            print(f"up to date ({out['current']})")
    elif sub == "apply":
        print(out.get("message") or f"updated to {out['version']}")
    else:
        print(f"put back {out['restored']}")


def cmd_uninstall(rest):
    """Take Project Pals out (bin/crewuninstall.py). Like installing an update, it's the owner's: a
    click in About (Uninstall), or the owner typing "uninstall" at their own terminal. The module
    checks that itself (Grok T56 H1), so every way in is held the same. --dry-run only lists."""
    import crewuninstall
    bad = [a for a in rest if a not in ("--purge", "--dry-run", "--json")]
    if bad:
        die("pal uninstall [--purge] [--dry-run] [--json]")
    dry, as_json = "--dry-run" in rest, "--json" in rest
    if not dry:
        update_log(f"uninstall{' --purge' if '--purge' in rest else ''} asked by {f'terminal {ME}' if ME else 'the app or a shell'}"
                   f"{'' if click_of() else ', no click'}")
    try:
        out = crewuninstall.uninstall(purge="--purge" in rest, dry=dry, log=(lambda *_: None) if as_json else print,
                                      click=click_of(), args=owner_args())
    except crewuninstall.NotAllowed as e:
        update_log(f"uninstall refused: {e}")
        die(str(e))
    if not dry and "--purge" not in rest:   # (a purge took the log with it: don't make it again)
        update_log(f"uninstall done: removed {len(out['removed'])}, restored {len(out['restored'])}")
    if as_json:
        print(json.dumps(out))
        return
    for n in out["notes"]:
        print(f"note: {n}")
    print("Nothing was changed (--dry-run)." if dry else f"Project Pals is uninstalled from {HOME}.")


# ── Home (bin/crewhome.py) ───────────────────────────────────────────────────────────────────

def home_topic(spaces, spec):
    """'Pal#topic' as Project Pals names it, when it's open; else as given (a pal asleep)."""
    if not spec:
        return None
    try:
        space, tab = find(spec, spaces)
        return f"{space['name']}#{chan(tab)}" if "#" in spec else space["name"]
    except SystemExit:
        raise
    except Exception:
        return spec.strip()


def home_answer_to(spaces, x, answer):
    """The owner's answer, as a card from them to whoever asked (held on its desk if it's asleep)."""
    to = x.get("by") or ""
    if not to or "#" not in to and not to.strip():
        return "nobody to tell (it wasn't asked from a topic)"
    try:
        space, tab = find(to, spaces)
        dest = f"{space['name']}#{chan(tab)}"
    except SystemExit:
        return f"{to} isn't open; the answer is on Home"
    except Exception:
        return f"{to} isn't open; the answer is on Home"
    who = crewdesk.sender(spaces)
    title = f"Re {x['id']}: {answer}"[:crewdesk.TITLE_MAX]
    body = f"You asked on Home: {x.get('title', '')}\n\n{OWNER} picked: {answer}"
    card = crewdesk.create("tell", dest, title, body, frm=who["from"], from_kind=who["from_kind"], proof=who["proof"],
                           via="pal home answer")
    card, _, what = crewdesk.deliver(card, spaces)
    return f"told {dest} ({what}) · card {card['id']}"


def cmd_computer(spaces, rest):
    """pal computer [Pal] [today|todo|calendar|journal|pages] [--json] [--start YYYY-MM-DD] [--days 7]
    What a pal's Computer shows (crew-boards/pal-computer/design.md). Read-only: it's a view."""
    import crewbrain
    import crewcomputer
    import crewdesk
    import crewnotebook
    import crewroutines
    import crewsleep
    import crewtasks
    views = ("today", "todo", "calendar", "journal", "pages")
    pos, o = opts(rest, ("start", "days"), ("json",))
    view = next((p for p in pos if p in views), "today")
    who = [p for p in pos if p not in views]
    space, rec, name = pal_of(spaces, " ".join(who) if who else None)
    tasks = crewtasks.load()["tasks"]
    cards = [c for _, c in crewdesk.mine(name)]
    if view in ("today", "todo"):
        if view == "todo":
            out = crewcomputer.todo(name, tasks, cards)
        else:
            d = crewbrain.brain_dir(name, {**rec, "folder": rec.get("folder") or space.get("folder")})
            mission = crewbrain.parse_mission(crewbrain.read(d, "mission.md"))
            live = hc_terminals()
            asleep = {t.get("terminal") for t in space.get("tabs", []) for t in t.get("terminals", []) if t
                      and crewsleep.slept(t.get("terminal"))}
            out = crewcomputer.today_view(name, space, live, tasks, cards, mission, asleep)
    elif view == "calendar":
        import datetime
        try:
            start = datetime.date.fromisoformat(o["start"]) if o.get("start") else None
        except ValueError:
            die("--start takes a date: 2026-11-09")
        today = datetime.date.today()
        start = start or today - datetime.timedelta(days=today.weekday())
        days = max(1, min(42, int(o.get("days") or 7)))
        s_ms = int(datetime.datetime.combine(start, datetime.time()).timestamp() * 1000)
        e_ms = s_ms + days * crewcomputer.DAY_MS
        routines = crewroutines.load()
        runs = {r["id"]: crewcomputer.routine_runs(r, s_ms, e_ms) for r in routines if crewcomputer.norm(r.get("bot") or "") == crewcomputer.norm(name)}
        feed_days = max(8, (today - start).days + 2)
        out = crewcomputer.calendar(name, crewcomputer.read_feed(feed_days), tasks, routines, start, days, next_runs=runs)
    elif view == "journal":
        out = {"pal": name, "days": crewnotebook.days(name, int(o.get("days") or 7)), "week": crewnotebook.week(name)}
    else:
        out = {"pal": name, "pages": crewcomputer.pages(name), "folder": str(crewcomputer.pages_dir(name))}
    if o.get("json"):
        print(json.dumps(out, ensure_ascii=False))
        return
    # A short human read; the desktop and the Chief use --json.
    if view == "today":
        print(f"{name}'s computer · today" + (f"\nfocus: {out['focus']}" if out["focus"] else ""))
        for t in out["topics"]:
            print(f"  #{t['topic']:<14} {t['state']:<8} " + (f"{t['task']['id']} {t['task']['title']}" if t["task"] else ""))
        for r in out["next"]:
            print(f"  next: {r['id']} {r['title']}" + (f" · {r['due_label']}" if r["due_label"] else ""))
        print(f"  desk: {out['desk']['open']} open" + (f", {out['desk']['needs_you']} need you" if out["desk"]["needs_you"] else ""))
    elif view == "todo":
        for k in ("doing", "next", "blocked", "done_today"):
            for r in out[k]:
                print(f"{k.replace('_', ' '):<10} {r['id']} {r['title']}" + (f" · {r['due_label']}" if r["due_label"] else ""))
        for c in out["cards"]:
            print(f"card       {c['id']} [{c['status']}] {c['title']}")
    elif view == "calendar":
        for e in sorted(out["events"], key=lambda e: e.get("start") or e.get("at") or 0):
            if e["kind"] == "work":
                print(f"{time.strftime('%a %H:%M', time.localtime(e['start'] / 1000))}-{time.strftime('%H:%M', time.localtime(e['end'] / 1000))} #{e['topic']} worked")
            elif e["kind"] == "due":
                print(f"{e['day']} {e['task']} due: {e['title']}")
            else:
                print(f"{time.strftime('%a %H:%M', time.localtime(e['at'] / 1000))} {e['kind']} {e.get('task') or e.get('name') or e.get('routine') or ''}")
    elif view == "journal":
        for d in out["days"]:
            print(f"{d['day']}: {len(d['entries'])} entries")
    else:
        print("\n".join(p["name"] for p in out["pages"]) or f"(no pages yet: {out['folder']})")


def cmd_page(spaces, rest):
    """pal page ls [Pal] | show "<title>" [--pal P] | write "<title>" -F file|- | rm "<title>"
    A pal's freeform pages (crew-memory/<pal>/pages/*.md), shown in its Computer's Notes. A pal writes
    only its own; the owner edits any in Notes' folder (Obsidian or an editor)."""
    import crewbrain
    import crewcomputer
    sub, args = (rest[0], rest[1:]) if rest and rest[0] in ("ls", "show", "write", "rm") else ("ls", rest)
    if sub == "-F":
        sub = "ls"
    pos, o = opts(args, ("pal", "file"), ())
    if sub == "ls":
        _, _, name = pal_of(spaces, (pos[0] if pos else None) or o.get("pal"))
        print("\n".join(p["name"] for p in crewcomputer.pages(name)) or f"(no pages for {name} yet)")
        return
    if not pos:
        die(f'pal page {sub} "<title>"')
    title = " ".join(pos)
    if sub == "show":
        _, _, name = pal_of(spaces, o.get("pal"))
        path = crewcomputer.page_path(name, title)
        if not path.exists():
            die(f"{name} has no page called '{title}'")
        print(path.read_text())
        return
    space, _ = my_bot(spaces)
    if not space:
        die("only a pal writes pages (its own); edit any page in its Computer's Notes folder")
    path = crewcomputer.page_path(space["name"], title)
    if sub == "rm":
        if not path.exists():
            die(f"no page called '{title}'")
        path.unlink()
        print(f"removed {space['name']}'s page '{title}'")
        return
    text = file_opt(o)
    path.parent.mkdir(parents=True, exist_ok=True)
    crewbrain.write(path.parent, path.name, text if text.endswith("\n") else text + "\n")
    print(f"wrote {space['name']}'s page '{title}' ({len(text)} characters)")


def cmd_popout(spaces, rest):
    """pal popout: a topic's live terminal in its own desktop window (bin/crewpopout.py). Putting a
    window on the owner's desktop, pinning it or closing it is the owner's click; ls is anyone's."""
    import crewpopout
    pos = [a for a in owner_args()[1:]]
    sub = pos[0] if pos else "ls"
    if sub == "ls":
        keys = crewpopout.open_keys()
        print("\n".join(keys) if keys else "no pop-outs open")
        return
    if sub in ("pin", "close") and len(pos) == 2:
        require_owner(f"{sub} a pop-out window")
        key = crewpopout.slug(pos[1])
        if sub == "close":
            print("closed" if crewpopout.close_popout(key) else "it wasn't open")
            return
        state = crewpopout.toggle_pin(key)
        if state is None:
            die("couldn't pin it: no pop-out window found, or this isn't Hyprland (pin it with your window manager)")
        print("pinned" if state else "unpinned")
        return
    if len(pos) != 1:
        die('usage: pal popout <Pal[#topic]> | ls | pin KEY | close KEY')
    require_owner("pop a topic out into its own window")
    space, tab = find(pos[0], spaces)
    x = lead(tab)
    if not x or not x.get("terminal"):
        die(f"{space['name']} #{chan(tab)} has no terminal (it's asleep: open the topic to wake it)")
    name = space["name"].split(" - ")[0]
    try:
        key, what = crewpopout.open_popout(x["terminal"], f"{space['name']}#{chan(tab)}",
                                           {"pal": name, "topic": chan(tab), "space": space.get("id"), "tab": tab.get("id"), "home": str(HOME)})
    except FileNotFoundError as e:
        die(str(e))
    print(f"{what} {key}")


def cmd_home(spaces, rest):
    sub = rest[0] if rest and not rest[0].startswith("--") else "ls"
    args = rest[1:] if rest and not rest[0].startswith("--") else rest
    me, name = whoami(spaces)
    by = me or name
    # Repeatable: --option (each may be followed by --does "what it does"), --link, --image.
    options, does, links, images, clean, i = [], [], [], [], [], 0
    while i < len(args):
        a = args[i]
        if a in ("--option", "--does", "--link", "--image") and i + 1 < len(args):
            v = args[i + 1]
            if a == "--option":
                options.append(v)
            elif a == "--does":
                if not options:
                    die("--does goes right after the --option it explains")
                does.extend([""] * (len(options) - 1 - len(does)))
                if len(does) >= len(options):
                    die("one --does per --option")
                does.append(v)
            elif a == "--link":
                links.append(v)
            else:
                images.append(v)
            i += 2
        else:
            clean.append(a); i += 1
    args = clean
    if (options or does or links or images) and sub != "ask":
        die("only pal home ask takes --option, --does, --link and --image")
    try:
        if sub in ("ls", "list", "show"):
            pos, o = opts(args, ("factory",), ("json", "all"))
            h = crewhome.load()
            # With several factories, Home is the factory you're in: a pal's own, else the one the app
            # shows. --factory NAME picks another, --factory all shows every factory's.
            fstore = crewfactories.load()
            if crewfactories.several(fstore) or o.get("factory"):
                want = o.get("factory") or (crewfactories.factory_of(name, fstore) if me else crewfactories.current(fstore))
                for x in h["items"]:
                    x["factory"] = crewfactories.factory_of_item(x, fstore)
                if want != "all":
                    fid = crewfactories.get(want, fstore)["id"]
                    h["items"] = [x for x in h["items"] if x["factory"] == fid]
            if o.get("json"):
                print(json.dumps({**h, "installs": crewhome.installs(10)}, ensure_ascii=False))
                return
            items = h["items"] if o.get("all") else [x for x in h["items"] if x.get("status") in ("open", "parked")]
            print("\n".join(crewhome.line(x) for x in items) or "(nothing on Home)")
            rel = h["release"]
            if rel.get("next") or rel.get("queued"):
                print(f"next release: {rel.get('next') or '?'}" + (f" · {rel['note']}" if rel.get("note") else ""))
                for q in rel["queued"]:
                    print(f"  {q['id']}  {q['text']}")
        elif sub == "ask" and args:
            pos, o = opts(args, ("topic", "body", "recommend", "why"))
            if len(images) > crewhome.IMAGES_MAX:
                die(f"at most {crewhome.IMAGES_MAX} images")
            imgs = [str(Path(desk_attach(f)).resolve().relative_to(DATA)) for f in images]
            x = crewhome.add("ask", " ".join(pos), by=by, body=o.get("body", ""), options=options, topic=home_topic(spaces, o.get("topic")),
                             does=does, recommend=o.get("recommend"), why=o.get("why"), links=links, images=imgs)
            print(crewhome.line(x))
        elif sub == "recommend" and len(args) >= 2:
            pos, o = opts(args, ("why",))
            rec = crewhome.recommend(pos[0], " ".join(pos[1:]), by=by, why=o.get("why"))
            print(f"recommended {rec['option']} for {pos[0]}" + (f": {rec['why']}" if rec.get("why") else ""))
        elif sub == "login" and args:
            pos, o = opts(args, ("topic", "title"))
            if not o.get("topic"):
                die('pal home login "! command" --topic "Pal#topic" (where the owner types it)')
            topic = home_topic(spaces, o["topic"])
            x = crewhome.add("login", o.get("title") or "Log in to continue", by=by, command=" ".join(pos), topic=topic)
            print(crewhome.line(x))
        elif sub == "link" and args:
            pos, o = opts(args, ("topic", "title"))
            x = crewhome.add("link", o.get("title") or pos[0], by=by, url=pos[0], topic=home_topic(spaces, o.get("topic")), status="done")
            print(crewhome.line(x))
        elif sub == "note" and args:
            x = crewhome.add("note", " ".join(args), by=by, status="done")
            print(crewhome.line(x))
        elif sub == "deploy" and args:
            pos, o = opts(args, ("topic",))
            x = crewhome.add("deploy", " ".join(pos), by=by, topic=home_topic(spaces, o.get("topic")))
            print(crewhome.line(x))
        elif sub == "queue":
            pos, o = opts(args, ("release", "note"))
            q, rel = crewhome.queue(" ".join(pos), by=by, release=o.get("release"), note=o.get("note"))
            print(f"queued for {rel.get('next') or 'the next release'}: {q['id']} {q['text']}" if q else f"next release: {rel.get('next') or '?'}")
        elif sub == "unqueue" and args:
            q = crewhome.unqueue(args[0])
            print(f"unqueued {q['id']} {q['text']}")
        elif sub == "done" and args:
            print(crewhome.line(crewhome.close(args[0], "done", by=by, result=" ".join(args[1:]) or None)))
        elif sub == "drop" and args:
            print(crewhome.line(crewhome.close(args[0], "dropped", by=by)))
        elif sub == "park" and args:
            text = " ".join(args)
            if re.fullmatch(r"h-[0-9a-f]{2,6}", text):
                print(crewhome.line(crewhome.park(text, by=by)))
            else:
                print(crewhome.line(crewhome.add("later", text, by=by, status="parked")))
        elif sub == "unpark" and args:
            print(crewhome.line(crewhome.unpark(args[0], by=by)))
        elif sub == "answer" and len(args) >= 2:
            # The owner's pick, from a click in Project Pals (main proved it); never a pal's, never typed.
            if not owner_proven():
                require_owner("answer a question on Home")
            x = crewhome.answer(args[0], " ".join(args[1:]), by=OWNER)
            print(crewhome.line(x))
            print(home_answer_to(spaces, x, x["answer"]))
        elif sub == "seen":
            if not owner_proven():
                require_owner("mark Home seen")
            crewhome.mark_seen()
            print("Home: all seen")
        else:
            die(__doc__)
    except crewhome.HomeError as e:
        die(str(e))


def cmd_factory(rest):
    """pal factory: the factories. Reading is anyone's; every change is the owner's click."""
    sub = rest[0] if rest and not rest[0].startswith("--") else "ls"
    args = rest[1:] if rest and not rest[0].startswith("--") else rest
    # Every pal there is: the ones Project Pals has notes on, and (when the app answers) every open space.
    names = {b["name"] for b in records().values() if b.get("name")}
    try:
        names |= {sp["name"] for sp in herdr_spaces()}
    except CrewError:
        pass
    # The Chief sits above every factory and is in none of them.
    import crewchief
    names = sorted(n for n in names if not crewchief.is_chief_pal(n))

    def not_chief(pal):
        if pal and crewchief.is_chief_pal(pal):
            die(f"{pal} is the Chief: it's above every factory, and in none of them")
        return pal
    try:
        if sub in ("ls", "list"):
            pos, o = opts(args, (), ("json",))
            store = crewfactories.load()
            if o.get("json"):
                v = crewfactories.view(store)
                for f in v["factories"]:
                    f["members"] = crewfactories.pals_of(f["id"], names, store)
                print(json.dumps(v, ensure_ascii=False))
                return
            print("\n".join(crewfactories.line(f, store, names) for f in crewfactories.factories(store)))
            if not crewfactories.several(store):
                print("One factory: your crew. pal factory new NAME makes another (from Project Pals: Ctrl+Shift+G).")
        elif sub == "show":
            pos, o = opts(args, (), ("json",))
            store = crewfactories.load()
            f = crewfactories.get(pos[0] if pos else crewfactories.current(store), store)
            members = crewfactories.pals_of(f["id"], names, store)
            if o.get("json"):
                print(json.dumps({**f, "members": members, "home": crewfactories.TEMPLATES[f["template"]]["home"]}, ensure_ascii=False))
                return
            print(crewfactories.line(f, store, names))
            print(f"  foreman: {f['foreman'] or '(none yet)'}" + (f" #{f['foreman_topic']}" if f["foreman"] and f["foreman_topic"] else ""))
            print(f"  pals: {', '.join(members) or '(none yet)'}")
            print(f"  Home: {', '.join(crewfactories.TEMPLATES[f['template']]['home'])}")
        elif sub == "new" and args:
            pos, o = opts(args, ("template", "foreman", "foreman-topic"))
            require_owner("making a factory")
            f = crewfactories.new(" ".join(pos), o.get("template") or "project-crew", not_chief(o.get("foreman")), o.get("foreman-topic"))
            print(f"made the factory {f['name']} ({f['id']})")
        elif sub == "switch" and args:
            require_owner("switching the factory the app shows")
            print(f"showing {crewfactories.switch(' '.join(args))['name']}")
        elif sub == "move" and len(args) >= 2:
            require_owner("moving a pal to another factory")
            f = crewfactories.move(not_chief(args[0]), " ".join(args[1:]))
            print(f"{args[0]} is in {f['name']}")
        elif sub == "foreman" and args:
            pos, o = opts(args, ("topic",))
            require_owner("naming a factory's foreman")
            f = crewfactories.set_foreman(pos[0], not_chief(pos[1] if len(pos) > 1 else ""), o.get("topic"))
            print(f"{f['name']}: foreman {f['foreman'] or '(none)'}")
        elif sub == "rename" and len(args) >= 2:
            require_owner("renaming a factory")
            print(f"it's {crewfactories.rename(args[0], ' '.join(args[1:]))['name']} now")
        elif sub in ("rm", "remove") and args:
            require_owner("removing a factory")
            f, back = crewfactories.remove(" ".join(args))
            print(f"removed {f['name']}" + (f"; back in your crew: {', '.join(back)}" if back else ""))
        else:
            die("pal factory [ls|show NAME] | new NAME [--template T] [--foreman Pal] | switch NAME | move PAL NAME | foreman NAME [PAL] | rename NAME NEW | rm NAME")
    except crewfactories.FactoryError as e:
        die(str(e))


# ── main ─────────────────────────────────────────────────────────────────────────────────────

def main(argv):
    global ARGV
    if not argv:
        argv = ["bots"]
    # -F is --file (pal mission propose -F draft.md).
    argv = ["--file" if a == "-F" else a for a in argv]
    ARGV = list(argv)
    argv = owner_args()   # the click token is checked by require_owner, not parsed as an option
    cmd, rest = argv[0], argv[1:]
    # The app speaks as the owner only with a click token for exactly this command line (tell, ask and
    # task: the Tasks dialog, Review's notes). A bad or used token is refused, never downgraded.
    if click_of() and cmd in ("tell", "ask", "task", "desk", "home", "sleep", "wake"):
        prove_owner(owner_args(), click_of())
    if cmd in ("-h", "--help", "help"):
        print(__doc__); return
    # The Chief (crew-boards/chief/design.md) only reads and hands work to the head pal's #ops.
    import crewchief
    if crewchief.caller_is_chief():
        why = crewchief.cli_refusal(cmd, rest)
        if why:
            die(why)
    if cmd == "room":
        os.execvp("pal-room", ["pal-room", *rest])
    if cmd == "primer":
        print(PRIMER); return
    if cmd in ("approvals", "approve", "deny"):
        inbox = "--inbox" in rest   # the Inbox's buttons say so, for the record
        rest = [a for a in rest if a != "--inbox"]
        return cmd_approvals(None if cmd == "approvals" else cmd, rest[0] if rest else die(f"crew {cmd} <id>"),
                             " ".join(rest[1:]) or None, inbox) if cmd != "approvals" else cmd_approvals()
    if cmd == "skill":
        return cmd_skill([], rest)
    if cmd == "version":
        ins = crewupdate.installed()
        print(f"{ins.get('name', 'Project Pals')} {ins.get('version', '?')} ({ins.get('source', '?')}, from {ins.get('repo', '?')})")
        # The Herdr on PATH now, against the range this version was released for (pals.json "herdr").
        import crewcompat
        c = crewcompat.check({"herdr": (ins.get("herdr") or {}).get("range")})
        if (ins.get("herdr") or {}).get("range"):
            print(f"supports {crewcompat.supported_line({'herdr': ins['herdr']['range']})}")
        for prog in c["programs"]:
            print(prog["message"])
        return
    if cmd == "update":
        return cmd_update(rest)
    if cmd == "uninstall":
        return cmd_uninstall(rest)
    if cmd == "settings":
        return cmd_settings(rest)
    if cmd in ("factory", "factories"):
        return cmd_factory(rest)
    if cmd == "renamed":
        # A pal got a new name (the app runs this when it sees one): its memory folder and the
        # routines aimed at it follow. The owner's to do: the app passes its click token (Grok review H1).
        require_owner("renaming pals")
        if len(rest) != 2 or not rest[1].strip():
            die('pal renamed "Old name" "New name"')
        renamed(rest[0], rest[1].strip())
        print(f"{rest[0]} is now {rest[1].strip()}: its memory and routines moved")
        return
    spaces = herdr_spaces()
    if cmd in ("team", "pals", "bots", "ls"):
        cmd_bots(spaces)
    elif cmd in ("overview", "world", "everything"):
        cmd_overview(spaces, deep="--deep" in rest)
    elif cmd == "feed":
        _, o = opts(rest, ("n",), ("all",))
        cmd_feed(spaces, o.get("all", False), int(o.get("n", 40)))
    elif cmd == "tell" and len(rest) >= 2:
        pos, o = opts(rest, (), ("now",))
        cmd_tell(spaces, pos[0], " ".join(pos[1:]), o.get("now", False))
    elif cmd == "ask" and len(rest) >= 2:
        pos, o = opts(rest, ("timeout",))
        cmd_ask(spaces, pos[0], " ".join(pos[1:]), int(o.get("timeout", 600)))
    elif cmd == "peek" and rest:
        pos, o = opts(rest, ("lines", "n"))
        cmd_peek(spaces, pos[0], int(o.get("lines") or o.get("n") or 60))
    elif cmd == "hire" and rest:
        pos, o = opts(rest, ("harness", "role", "channel", "folder", "machine", "task", "model"), ("god", "show", "partner", "chief"))
        if not pos and o.get("god"):
            pos = [settings()["head"]]
        if o.get("god"):
            # The head pal lives where its brief is (data/crew-god, rendered by install.sh), so
            # whatever brain runs it reads the brief. A folder given by hand wins.
            from crewlib import render_god
            render_god()
            if (HOME / "data" / "crew-god" / "AGENTS.md").exists():
                o.setdefault("folder", str(HOME / "data" / "crew-god"))
        if o.get("chief"):
            # The Chief (crew-boards/chief/design.md): the owner's chief of staff, above the head pal.
            # Only the owner hires it (the pop-up's Hire button, a click), at most one, in its own home
            # with its brief, in #chief, on Opus unless a model is given.
            import crewchief
            require_owner("hiring the Chief")
            if crewchief.record():
                die(f"you already have a Chief: {crewchief.name()}")
            pos = pos or [crewchief.NAME]
            home = crewchief.render(chief=" ".join(pos))
            if not home:
                die("the Chief's brief isn't installed (run ./install.sh)")
            o["folder"] = str(home)
            o["role"] = crewchief.ROLE
            o.setdefault("channel", "chief")
            if (o.get("harness") or "claude") == "claude":
                o.setdefault("model", "opus")
        if o.get("partner"):
            # The idea partner, MUSE (Desk §13): its own home with its brief, the Idea partner role, and
            # Sonnet unless a model is given.
            from crewlib import render_partner
            pos = pos or ["MUSE"]
            home = render_partner()
            if not home:
                die("the idea partner's brief isn't installed (run ./install.sh)")
            o.setdefault("folder", str(home))
            o.setdefault("role", "Idea partner")
            o.setdefault("channel", "ideas")
            if (o.get("harness") or "claude") == "claude":
                o.setdefault("model", "sonnet")
        if not pos:
            die("hire who? pal hire <Name> [--harness claude] ...")
        if o.get("folder"):
            o["folder"] = os.path.abspath(os.path.expanduser(o["folder"]))
        out = request("hire", spaces, name=" ".join(pos), **o)
        if o.get("chief"):
            print(f"hired {out['name']} ({out['harness']}) with {out['channel']}. It lives in its pop-up: Ctrl+Shift+J; nothing is sent to it but your words there.")
        else:
            print(f"hired {out['name']} ({out['harness']}) with {out['channel']}. Reach it with: pal tell \"{out['name']}\" \"...\"")
        if "claude" in str(out.get("argv") or out["harness"]).lower():
            watch_for_trust(out["name"], out["channel"])
    elif cmd in ("topic", "channel") and rest and rest[0] in ("area", "areas"):
        cmd_topic_area(spaces, rest[1:])
    elif cmd in ("topic", "channel") and len(rest) >= 2:   # pal channel: the name before 0.4.0
        pos, o = opts(rest, ("brief", "category", "harness", "base", "model", "area"), ("worktree",))
        area = o.pop("area", None)
        extra = {}
        if o.pop("worktree", False):
            space, _ = find(pos[0], spaces)
            extra["worktree"] = make_worktree(space, " ".join(pos[1:]), o.pop("base", None))
            extra["folder"] = extra["worktree"]["path"]
        o.pop("base", None)
        out = request("channel", spaces, bot=pos[0], name=" ".join(pos[1:]), **o, **extra)
        brain = out.get("harness") or "its brain"
        print(f"{out['bot']} now has {out['channel']}, running {brain}"
              + (f" on its own branch {extra['worktree']['branch']} ({extra['folder']})" if extra else ""))
        if out.get("guessed"):
            print(f"({out['bot']}'s own brain isn't on record, so this uses {'yours' if out.get('why') == 'yours' else 'the default'}; "
                  f"pick another with --harness)")
        if area:
            import crewareas
            a = crewareas.file(out["bot"], out["channel"], area)
            print(f"filed under {a['name']}" if a else "left unsorted")
        watch_start(out["bot"], out["channel"], brain)
    elif cmd == "invite" and len(rest) >= 2:
        import crewchief
        for w in rest[1:]:
            crewchief.refuse_target(w, "room invites")
        out = request("invite", spaces, room=rest[0], who=rest[1:])
        if out.get("added"):
            print(f"added {', '.join(out['added'])} to #{rest[0].lstrip('#')} (briefed)")
            if out.get("woke"):
                print(f"woke {', '.join(out['woke'])} in a new topic for the room (it was asleep)")
        if out.get("skipped"):
            print(f"already in it: {', '.join(out['skipped'])}")
    elif cmd == "sleep":
        cmd_sleep(spaces, rest)
    elif cmd == "wake":
        cmd_wake(spaces, rest)
    elif cmd == "task":
        cmd_task(spaces, rest)
    elif cmd == "desk":
        cmd_desk(spaces, rest)
    elif cmd == "home":
        cmd_home(spaces, rest)
    elif cmd == "welcome":
        # The welcome tour (RECIPE "The welcome tour"). Read-only from here: the tour runs on Home.
        import crewwelcome
        pos, o = opts(rest, (), ("json",))
        if pos[:1] == ["folders"]:
            taken = [b.get("folder") for b in records().values() if b.get("folder")]
            found = crewwelcome.folders(taken=taken)
            if o.get("json"):
                print(json.dumps(found, ensure_ascii=False))
            else:
                print("\n".join(f"{f['show']}  ({f['name']})" for f in found) or "no project folders found in the usual places")
        else:
            print(crewwelcome.status(settings()))
    elif cmd == "popout":
        cmd_popout(spaces, rest)
    elif cmd == "computer":
        cmd_computer(spaces, rest)
    elif cmd in ("page", "pages"):
        cmd_page(spaces, rest)
    elif cmd == "routine":
        cmd_routine(spaces, rest)
    elif cmd == "mission":
        cmd_mission(spaces, rest)
    elif cmd == "notebook":
        cmd_notebook(spaces, rest)
    elif cmd == "dream":
        cmd_dream(spaces, rest)
    elif cmd == "brain":
        cmd_brain(spaces, rest)
    elif cmd == "agents":
        cmd_agents(spaces, rest)
    elif cmd in ("proposals", "proposal"):
        cmd_proposals(spaces, rest)
    elif cmd == "remember":
        cmd_remember(spaces, rest)
    elif cmd == "memory":
        cmd_memory(spaces, rest)
    elif cmd == "diff" and rest:
        pos, o = opts(rest, (), ("stat", "json"))
        cmd_diff(spaces, pos[0], "json" if o.get("json") else "stat" if o.get("stat") else "full")
    elif cmd == "land" and rest:
        pos, o = opts(rest, ("check",))
        cmd_land(spaces, pos[0], o.get("check"))
    else:
        die(__doc__)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except CrewError as e:
        die(str(e))
