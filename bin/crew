import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE if (HERE / "crewlib.py").exists() else Path.home() / ".local" / "lib" / "herdr-crew"))
from crewlib import (HOME, DATA, REQS, ROOMS, FEED, MEMORY, WORKTREES, HOOKED, ME, SHELLS, PRIMER, CrewError, OWNER, settings,
                     SETTINGS, die, load_json, save_json, locked, herdr_spaces, records, record_of, chan, lead, norm, find,
                     whoami, where_of, is_bot_terminal, live_agents, term_info, proc_comm, child_pids, shell_is_bare,
                     clear_osc_status, agent_running, screen, meaningful, enqueue, send_now, from_bot, daemon_alive,
                     remember, memory_text, memory_dir, slug, now_ms, new_id, append_jsonl, hc_terminals, is_agent, renamed,
                     trust_prompt, trust_notice)
