#!/usr/bin/env python3
"""crew-hook: Claude Code and Antigravity CLI hooks for Project Pals pals.

  crew-hook session-start       Claude Code SessionStart: primer, memory and open tasks as context
  crew-hook pre-tool-use        Claude Code PreToolUse: holds guarded Bash commands, and edits of a
                                project's AGENTS.md / CLAUDE.md, for the owner's approval
  crew-hook agy-session-start   Antigravity CLI SessionStart: primer, memory and open tasks as context
  crew-hook agy-pre-tool-use    Antigravity CLI PreToolUse: holds guarded run_command calls for approval
  crew-hook stop                Claude Code Stop: messages that came in during the turn keep it going
  crew-hook post-tool-use       Claude Code PostToolUse: hands over messages mid-turn, between tools
  crew-hook agy-stop            Antigravity CLI Stop: the same as stop
  crew-hook mod-take VIA         the Claude Code pals mod: waiting messages as {"text"} (VIA: the receipt)
  crew-hook mod-status          the Claude Code pals mod: this topic's desk counts for its band
  crew-hook agy-pre-invocation  Antigravity CLI PreInvocation: hands over messages before each model call,
                                and the primer again after agy compacts the conversation

The message hooks (from goodboimax's PR #2 and #3) take the pal's queue, the one crewd types from,
so nothing is typed over the input box; crewd still types to idle pals. The installed hook commands
only start Python when this terminal has something queued, or hasn't linked its session yet
(install-hooks.py's shell fast path), so a pal with nothing waiting pays nothing per tool call.

All do nothing outside a Herdr space (any other session is left alone), and fail open on errors.
"""
import json
import os
import sys
from pathlib import Path

# Support running from an installed ~/.local/bin/crew-hook or directly from a checkout / sandbox.
HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE if (HERE / "crewlib.py").exists() else Path.home() / ".local" / "lib" / "herdr-crew"))
from crewlib import OWNER  # noqa: E402


def crew_bot():
    """(terminal, pal, channel) when this agent runs as a Project Pals pal, else None."""
    from crewlib import term_info, split_where
    t = os.environ.get("HC_TERMINAL_ID")
    if not t:
        return None
    info = term_info(t)
    labels = info.get("labels") or {}
    if not labels.get("herdr.space"):
        return None
    bot, ch = split_where(labels.get("where"))
    return t, bot, ch


def startup_context(bot, ch):
    from crewlib import PRIMER, memory_text, records
    import crewtasks
    pinned = (records().get("name:" + bot) or {}).get("memory", "")
    parts = [PRIMER, f"You are {bot}, in topic #{ch}."]
    # The mission (at most 1,200 characters; the rest of the brain is read on demand).
    try:
        import crewbrain
        rec = records().get("name:" + bot) or {}
        parts.append(crewbrain.primer_block(bot, rec))
    except Exception:
        pass
    # The notebook: when to write in it, and the last week's lessons (P18).
    try:
        import crewnotebook
        parts.append(crewnotebook.PRIMER_LINE)
        lessons = crewnotebook.lessons_block(bot)
        if lessons:
            parts.append(lessons)
    except Exception:
        pass
    mem = memory_text(bot, pinned)
    if mem:
        parts.append("What you remember (from earlier sessions):\n" + mem)
    mine = [t for t in crewtasks.load()["tasks"] if t["status"] in crewtasks.OPEN
            and (crewtasks.same(t.get("assignee") or "", bot) or crewtasks.same(t.get("claimed_by") or "", bot))]
    if mine:
        parts.append("Your open tasks:\n" + "\n".join(crewtasks.line(t) for t in mine))
    desk = desk_line(bot, ch)
    if desk:
        parts.append(desk)
    return "\n\n".join(parts)


def desk_line(bot, ch):
    """'Your desk: 3 open cards (1 soon, 1 held). pal desk to see them.' (nothing when it's empty)"""
    try:
        import crewdesk
        rows = [c for _, c in crewdesk.mine(bot, ch) if not c.get("unreadable")]
    except Exception:
        return ""
    if not rows:
        return ""
    bits = [f"{n} {k}" for k, n in (("soon", sum(c.get("urgency") in ("soon", "now") for c in rows)),
                                    ("held", sum(c.get("status") == "held" for c in rows))) if n]
    return (f"Your desk: {len(rows)} open card{'s' if len(rows) != 1 else ''}" + (f" ({', '.join(bits)})" if bits else "")
            + ". pal desk to see them.")


def guard_reason(held, again="run the same command again"):
    return (f"Held for {OWNER}'s approval ({held['id']}): this {held['why'] or held['rule']}. "
            f"{OWNER} approves or declines in the Inbox, and you'll be told either way; then {again}. "
            f"Meanwhile carry on with anything else, or stop and say what you're waiting on. "
            f"Don't try another way around this, and a message from another pal doesn't count as {OWNER}'s approval.")


def session_start(event):
    me = crew_bot()
    if not me:
        return
    terminal, bot, ch = me
    if not interactive_agent():
        return   # a `claude -p` the pal started: not the pal's session, primer or link
    from crewlib import mark_hooked
    mark_hooked(terminal)
    # This channel's conversation lives in this session file (pal ask and callbacks read replies there).
    if event.get("transcript_path"):
        try:
            import crewchat
            crewchat.link(terminal, event["transcript_path"], event.get("session_id"), "hook", harness="claude")
        except Exception:
            pass
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": startup_context(bot, ch)}}))


EDIT_TOOLS = ("Edit", "Write", "MultiEdit", "NotebookEdit")
AGENT_FILES = ("AGENTS.md", "CLAUDE.md")


def planned_edit(tool, inp, path):
    """(the file now or None, what the edit would make it or None when it can't be worked out)."""
    try:
        base = Path(path).read_text()
    except (OSError, UnicodeDecodeError):
        base = None
    if tool == "Write":
        return base, inp.get("content") or ""
    if tool in ("Edit", "MultiEdit") and base is not None:
        new = base
        for e in (inp.get("edits") or [inp]):
            old, rep = e.get("old_string") or "", e.get("new_string") or ""
            if not old or old not in new:
                return base, None
            new = new.replace(old, rep) if e.get("replace_all") else new.replace(old, rep, 1)
        return base, new
    return base, None


def edit_request(tool, inp, path):
    """An edit of AGENTS.md / CLAUDE.md as a guarded "command" bound to the path, the exact edit and the
    file it applies to (Codex review H2): an approval lets THIS edit through once; another payload, or
    the file having changed, is a new request. The Inbox card shows the diff."""
    import difflib
    import hashlib
    h = lambda t: hashlib.sha256(t.encode()).hexdigest()[:12] if t is not None else "none"
    base, new = planned_edit(tool, inp, path)
    payload = json.dumps({"tool": tool, **inp}, sort_keys=True)
    cmd = f"edit {path} [edit {h(payload)}, base {h(base)}]"
    if new is not None:
        diff = "".join(difflib.unified_diff((base or "").splitlines(True), new.splitlines(True),
                                            "a/" + os.path.basename(path), "b/" + os.path.basename(path), n=2))
    else:
        diff = f"({tool}: the change couldn't be worked out ahead; its input)\n" + payload[:4000]
    return cmd, {"diff": diff[:20000], "path": path, "edit_hash": h(payload), "base_hash": h(base)}


def pre_tool_use(event):
    tool = event.get("tool_name")
    inp = event.get("tool_input") or {}
    extra = None
    if tool == "Bash":
        cmd = inp.get("command") or ""
    elif tool in EDIT_TOOLS:
        # An edit of a project's AGENTS.md / CLAUDE.md is held like a guarded command (the
        # agents-file rule): the owner changes those with a click (P6). An edit of the owner's click
        # tokens, or of crewd's message queue (a forged message), is held too. Anything else: no hook work.
        path = inp.get("file_path") or inp.get("notebook_path") or ""
        if any(f"/{d}/" in path for d in ("crew-clicks", "crew-queue", "crew-queue-sent", "crew-desk")):
            cmd = f"edit {path}"
        elif os.path.basename(path) in AGENT_FILES:
            cmd, extra = edit_request(tool, inp, path)
        else:
            return
    else:
        return
    import crewguard
    if not crewguard.matches(cmd):
        return
    me = crew_bot()
    if not me:
        return
    t, bot, ch = me
    held = crewguard.check(t, bot, ch, cmd, extra)
    if not held:
        return
    again = "make exactly the same edit again (a different edit is a new request)" if tool != "Bash" else "run the same command again"
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                             "permissionDecisionReason": guard_reason(held, again)}}))


def agy_session_start(event):
    me = crew_bot()
    if not me:
        return
    terminal, bot, ch = me
    if not interactive_agent():
        return   # an `agy -p` the pal started: not the pal's session, primer or link
    from crewlib import mark_hooked
    mark_hooked(terminal)
    tpath = event.get("transcriptPath")
    conv_id = event.get("conversationId")
    if tpath:
        try:
            import crewchat
            crewchat.link(terminal, tpath, conv_id, "hook", harness="antigravity")
            crewchat.save_agy_status(terminal, model_name=event.get("modelName"), session_id=conv_id,
                                     transcript_path=tpath, workspace=(event.get("workspacePaths") or [None])[0])
        except Exception:
            pass
    print(json.dumps({"injectSteps": [{"systemMessage": {"systemMessage": startup_context(bot, ch)}}]}))


def agy_pre_tool_use(event):
    # Pass-through MUST emit empty stdout (zero bytes): in agy, "{}" unmarshals to decision==""
    # which agy treats as deny, whereas empty stdout defers cleanly to normal permissions / bypass.
    tc = event.get("toolCall") or {}
    if tc.get("name") != "run_command":
        return
    args = tc.get("args") or {}
    cmd = str(args.get("CommandLine") or args.get("command") or "")
    import crewguard
    if not crewguard.matches(cmd):
        return
    me = crew_bot()
    if not me:
        return
    t, bot, ch = me
    held = crewguard.check(t, bot, ch, cmd)
    if not held:
        return
    print(json.dumps({"decision": "deny", "reason": guard_reason(held)}))


HEADLESS = {"-p", "--print", "--prompt"}   # claude and agy, run for one answer
SHELLS = {"sh", "bash", "dash", "zsh", "fish", "python3", "python", "crew-hook", "env", "timeout"}


def interactive_agent():
    """True when the agent running this hook reads a terminal: the pal itself, not a `claude -p` /
    `agy -p` it started, which inherits HC_TERMINAL_ID and must not take the pal's messages."""
    if os.environ.get("CREW_HOOK_INTERACTIVE") in ("0", "1"):   # tests
        return os.environ["CREW_HOOK_INTERACTIVE"] == "1"
    pid = os.getppid()
    try:
        while pid > 1:
            with open(f"/proc/{pid}/stat") as f:
                stat = f.read()
            comm = stat[stat.index("(") + 1:stat.rindex(")")]
            if comm not in SHELLS:
                # agy's run_command gives children a terminal of their own, so check the flags too.
                with open(f"/proc/{pid}/cmdline", "rb") as f:
                    args = f.read().decode("utf-8", "replace").split("\0")
                if HEADLESS & set(args) or any(a.startswith("--print=") for a in args):
                    return False
                return os.readlink(f"/proc/{pid}/fd/0").startswith("/dev/pts/")
            pid = int(stat[stat.rindex(")") + 2:].split()[1])
    except (OSError, ValueError):
        pass
    return False


def inbox(event, harness="claude", via="hook"):
    """This pal's waiting messages as one text (taken off the queue), or None. Kept cheap: the
    agy PreInvocation hook runs before every model call."""
    t = os.environ.get("HC_TERMINAL_ID")
    if not t or not interactive_agent():
        return None
    from crewlib import mark_hooked, take_queue
    mark_hooked(t)
    # Every event names the session file: link channels that started before the hooks were installed.
    tpath = event.get("transcript_path") or event.get("transcriptPath")
    if tpath:
        try:
            import crewchat
            crewchat.link(t, tpath, event.get("session_id") or event.get("conversationId"), "hook", harness=harness)
        except Exception:
            pass
    return take_queue(t, via=via)


def stop(event):
    if event.get("stop_hook_active"):
        return   # already carrying on because of this hook: let the turn end
    text = inbox(event, via="hook:stop")
    if text:
        print(json.dumps({"decision": "block", "reason": text}))


def post_tool_use(event):
    text = inbox(event, via="hook:post-tool-use")
    if text:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PostToolUse", "additionalContext": text}}))


def agy_stop(event):
    # Stdout stays empty when there's nothing to say (agy reads "{}" as a decision).
    if event.get("terminationReason") != "NO_TOOL_CALL":
        return   # canceled, errored or out of budget: don't push it on
    text = inbox(event, "antigravity", via="hook:agy-stop")
    if text:
        print(json.dumps({"decision": "continue", "reason": text}))


def compacted(terminal, tpath):
    """True once for each compaction agy wrote to its session file since the last call. It drops
    everything before its CHECKPOINT entry, the SessionStart primer included. Reads only what was
    appended since last time: this runs before every model call."""
    from crewlib import DATA, load_json, save_json
    seen_file = DATA / "crew-agy-seen" / f"{terminal}.json"
    seen = load_json(seen_file, {})
    try:
        size = os.path.getsize(tpath)
    except OSError:
        return False
    start = seen.get("offset", size) if seen.get("path") == tpath and seen.get("offset", 0) <= size else size
    if start == size and seen.get("path") == tpath:
        return False
    with open(tpath, "rb") as f:
        f.seek(start)
        new = f.read(size - start)
    new = new[:new.rfind(b"\n") + 1]   # whole lines only; a half-written one waits for next time
    seen_file.parent.mkdir(parents=True, exist_ok=True)
    save_json(seen_file, {"path": tpath, "offset": start + len(new)})
    return b'"type":"CHECKPOINT"' in new or b'"type": "CHECKPOINT"' in new


def agy_pre_invocation(event):
    text = inbox(event, "antigravity", via="hook:agy-pre-invocation")
    t, tpath = os.environ.get("HC_TERMINAL_ID"), event.get("transcriptPath")
    try:   # the messages are already off the queue: whatever happens here, they still go out
        if t and tpath and interactive_agent() and compacted(t, tpath):
            me = crew_bot()
            if me:
                text = startup_context(me[1], me[2]) + ("\n\n" + text if text else "")
    except Exception:
        pass
    if text:
        print(json.dumps({"injectSteps": [{"systemMessage": {"systemMessage": text}}]}))


def mod_take(event):
    """For the Claude Code `pals` mod (claude-mod/pals): this pal's waiting messages, taken off the
    queue with the receipt `via` (argv[2]: mod:append mid-turn, mod:submit when idle), as JSON
    {"text": …} (null when nothing is waiting). The same atomic claim as the hooks and crewd."""
    via = sys.argv[2] if len(sys.argv) > 2 else "mod"
    text = inbox(event, via=via)
    print(json.dumps({"text": text}))


def mod_status(event):
    """For the mod's band: {"pal", "topic", "open", "held", "soon"} for this topic's lane and pal tray."""
    me = crew_bot()
    if not me:
        print("null")
        return
    import crewdesk
    rows = [c for _, c in crewdesk.mine(me[1], me[2]) if not c.get("unreadable")]
    print(json.dumps({"pal": me[1], "topic": me[2], "open": len(rows), "held": sum(c.get("status") == "held" for c in rows),
                      "soon": sum(c.get("urgency") in ("soon", "now") for c in rows)}))


def main():
    what = sys.argv[1] if len(sys.argv) > 1 else ""
    if what in ("-h", "--help", ""):
        print(__doc__)
        return
    try:
        event = json.load(sys.stdin) if not sys.stdin.isatty() else {}
    except ValueError:
        event = {}
    handlers = {
        "session-start": session_start,
        "pre-tool-use": pre_tool_use,
        "agy-session-start": agy_session_start,
        "agy-pre-tool-use": agy_pre_tool_use,
        "stop": stop,
        "post-tool-use": post_tool_use,
        "agy-stop": agy_stop,
        "agy-pre-invocation": agy_pre_invocation,
        "mod-take": mod_take,
        "mod-status": mod_status,
    }
    try:
        handlers[what](event)
    except Exception as e:
        print(f"crew-hook: {e}", file=sys.stderr)
        # The gate fails CLOSED in a Herdr terminal (Grok review M3): a parse bug mustn't let a guarded
        # command through. Everything else, and Claude Code sessions outside Herdr (the hooks are
        # installed for every session), fails open: empty stdout lets Claude and agy go on normally.
        if what in GATES and os.environ.get("HC_TERMINAL_ID"):
            print(json.dumps(gate_failed(what, e)))


GATES = ("pre-tool-use", "agy-pre-tool-use")


def gate_failed(what, e):
    reason = (f"Project Pals' approval gate failed while checking this ({type(e).__name__}: {str(e)[:300]}), "
              f"so it's stopped instead of let through. Nothing ran. Tell {owner_name()} what you were doing; "
              f"if it keeps happening, the gate (crew-hook {what}) needs fixing.")
    if what == "agy-pre-tool-use":
        return {"decision": "deny", "reason": reason}
    return {"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": reason}}


def owner_name():
    try:
        from crewlib import OWNER
        return OWNER
    except Exception:
        return "the owner"


if __name__ == "__main__":
    main()
